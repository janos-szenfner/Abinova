prefix=@prefix@
exec_prefix=@exec_prefix@
libdir=@libdir@
includedir=@includedir@
datarootdir=@datarootdir@
pkgdatadir=@ABINOVA_DATADIR@
libabinova=true

Name: abinova-@ABINOVA_SERIES@
Description: Abinova word processing library
Version: @VERSION@
Requires: @ABINOVA_REQUIRED_PKGS@
Libs: -L${libdir} -labinova-@ABINOVA_SERIES@
Cflags: -I${includedir}/abinova-@ABINOVA_SERIES@
