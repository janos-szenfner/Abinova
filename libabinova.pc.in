prefix=@prefix@
exec_prefix=@exec_prefix@
libdir=@libdir@
includedir=@includedir@
datarootdir=@datarootdir@
pkgdatadir=@ABIWORD_DATADIR@
libabinova=true

Name: abinova-@ABIWORD_SERIES@
Description: Abinova word processing library
Version: @VERSION@
Requires: @ABIWORD_REQUIRED_PKGS@
Libs: -L${libdir} -labinova-@ABIWORD_SERIES@
Cflags: -I${includedir}/abinova-@ABIWORD_SERIES@
