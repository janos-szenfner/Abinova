# Autotools aux scripts (installed by autoreconf --install)
/INSTALL
/compile
/test-driver
/py-compile
/ar-lib

# libtoolize copies into m4/
m4/libtool.m4
m4/ltoptions.m4
m4/ltsugar.m4
m4/ltversion.m4
m4/lt~obsolete.m4

# Generated by autogen-common.sh
m4/plugin-builtin.m4
m4/plugin-configure.m4
m4/plugin-list.m4
m4/plugin-makefiles.m4

# configure/build generated files
*.pc
com.abisource.AbiWord.metainfo.xml
.dirstamp
po/*.strings
src/abi-resources.c
src/abi-resources.h
src/abiword
src/plugins/abi-builtin-plugins-calls.inc
src/plugins/abi-builtin-plugins-decls.inc
src/plugins/builtin-stamp
src/wp/ap/ap_wp_sidebar.cpp
src/wp/test/unix/testwrap.sh

# Build outputs
*.o
*.lo
*.la
*.a
*.so
*.dylib
*.exe
*.gmo
*.pot
*.stamp

# Misc
*~
*.bak
*.orig
*.rej
core
/ylwrap

# Vendored third-party deps ship their generated autotools files so
# they build without requiring autoconf-archive/matching autotools
!thirdparty/**/Makefile.in
!thirdparty/**/configure
!thirdparty/**/aclocal.m4
!thirdparty/**/config.h.in
!thirdparty/**/config.guess
!thirdparty/**/config.sub
!thirdparty/**/install-sh
!thirdparty/**/ltmain.sh
!thirdparty/**/missing
!thirdparty/**/depcomp
!thirdparty/**/ylwrap
!thirdparty/**/compile
!thirdparty/**/mkinstalldirs
!thirdparty/**/*.pc.in
src/wp/test/AbiWord-test
src/wp/test/supp.txt
src/wp/test/test-suite.log
src/wp/test/testwrap.sh-stamp
src/wp/test/unix/testwrap.sh.log
src/wp/test/unix/testwrap.sh.trs
