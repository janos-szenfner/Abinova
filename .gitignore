# libFuzzer instrumented build tree + crash artifacts (tools/build-fuzz.sh)
/fuzz-build/
# sanitizer instrumented build tree + valgrind logs (tools/check-san.sh)
/san-build/
# self-contained bundle output + staging (dist/linux-bundle.sh)
/dist/abinova-*-linux-*/
/dist/abinova-*-linux-*.stage*
# macOS build trees, staged installs + .app output (tools/build-macos.sh)
/build-macos/
/build-macos-*/
/Abinova.app/
# Windows build tree, staged install + bundle output (tools/build-windows-msys2.sh)
/build-windows/
/dist/abinova-*-windows-*/
