    <p style="Heading 1" xid="11">Rich Coverage Document</p>
    <p xid="12">This paragraph has <c props="font-weight:bold">bold</c>, <c props="font-style:italic">italic</c>, <c props="text-decoration:underline">underline</c>, <c props="text-decoration:line-through">strike</c>, <c props="text-decoration:overline">overline</c>, <c props="text-position:superscript">super</c> and <c props="text-position:subscript">sub</c> runs, plus <c props="color:AA0000; font-family:Courier New; font-size:14pt">colored mono</c> text.</p>
    <p xid="13" props="text-align:center"><c props="bgcolor:FFFF00">Centered and highlighted. A bookmark sits </c><bookmark type="start" name="covmark" xid="201"/>here<bookmark type="end" name="covmark" xml:id="" xid="202"/>.</p>
    <p xid="14">Visit <a xlink:href="https://example.com/" xid="203">the example site</a> for more. Page <field type="page_number" xid="205"/> of <field type="page_count" xid="206"/>; today is <field type="date" xid="207"/> at <field type="time" xid="208"/>.</p>
    <p style="Heading 2" xid="15">Lists</p>
    <p level="1" style="Numbered Heading 1" listid="8001" xid="209" props="margin-left:0.5in; text-indent:-0.25in; list-style:Numbered List"><field type="list_label" xid="210"/><c type="list_label">	</c>Numbered item one</p>
    <p level="1" listid="8001" xid="211" props="margin-left:0.5in; text-indent:-0.25in; list-style:Numbered List"><field type="list_label" xid="212"/><c type="list_label">	</c>Numbered item two</p>
    <p level="2" listid="8003" xid="213" props="margin-left:0.75in; text-indent:-0.25in; list-style:Numbered List"><field type="list_label" xid="214"/><c type="list_label">	</c>Nested number</p>
    <p level="1" listid="8002" xid="215" props="margin-left:0.5in; text-indent:-0.25in; list-style:Bullet List"><field type="list_label" xid="216"/><c type="list_label">	</c>Bullet item</p>
    <p xid="16">Footnote<field type="footnote_ref" footnote-id="0" style="Footnote Reference" xid="217"/><foot footnote-id="0" xid="218"><p style="Footnote Text" xid="219"><field type="footnote_anchor" footnote-id="0" style="Footnote Reference" xid="220"/> Footnote body text.</p></foot> and endnote<field type="endnote_ref" endnote-id="0" style="Footnote Reference" xid="221"/><endnote endnote-id="0" xid="222"><p style="Footnote Text" xid="223"><field type="endnote_anchor" endnote-id="0" style="Footnote Reference" xid="224"/> Endnote body text.</p></endnote> anchors.</p>
    <p xid="17">An annotated span<ann annotation-id="0" xid="66"><annotate annotation-id="0" xid="225" props="annotation-author:Coverage Tester; annotation-date:2026-10-04T10:00:00Z; annotation-initials:CT"><p xid="67"><c props="font-size:10pt">Annotation body text.</c></p></annotate> right here</ann> continues normally.</p>
