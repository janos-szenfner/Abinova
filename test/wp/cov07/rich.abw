<p xid="12"><c>This paragraph has </c><c props="font-weight:bold">bold</c><c>, </c><c props="font-style:italic">italic</c><c>, </c><c props="text-decoration:underline">underline</c><c>, </c><c props="text-decoration:line-through">strike</c><c>, </c><c props="text-decoration:overline">overline</c><c>, </c><c props="text-position:superscript">super</c><c> and </c><c props="text-position:subscript">sub</c><c> runs, plus </c><c props="color:AA0000; font-family:Courier New; font-size:14pt">colored mono</c><c> text.</c></p>
<p xid="13" props="text-align:center"><c props="bgcolor:FFFF00">Centered and highlighted. A bookmark sits </c><bookmark type="start" name="covmark"/><c>here</c><bookmark type="end" name="covmark"/><c>.</c></p>
