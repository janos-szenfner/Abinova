<?xml version='1.0' encoding='UTF-8'?>
<interface>
  <requires lib="gtk+" version="3.20" />
  <object class="GtkAdjustment" id="adjustment1">
    <property name="lower">20</property>
    <property name="upper">500</property>
    <property name="value">100</property>
    <property name="step-increment">1</property>
    <property name="page-increment">10</property>
  </object>
  <object class="GtkDialog" id="xap_UnixDlg_Zoom">
    <property name="title" translatable="yes">dialog1</property>
    <property name="resizable">0</property>
    
        <child><object class="GtkBox" id="dialog-vbox1">
          <property name="margin-start">12</property>
          <property name="margin-end">12</property>
          <property name="margin-top">12</property>
          <property name="margin-bottom">12</property>
        <property name="visible">1</property>
        <property name="orientation">vertical</property>
        <child>
          <object class="GtkBox" id="vbox1">
            <property name="visible">1</property>
            <property name="orientation">vertical</property>
            <property name="spacing">4</property>
            <child>
              <object class="GtkLabel" id="lbZoom">
                <property name="visible">1</property>
                <property name="margin-bottom">2</property>
                <property name="label" translatable="yes">&lt;b&gt;%s&lt;/b&gt;</property>
                <property name="use-markup">1</property>
                <property name="xalign">0</property>
              </object>
              </child>
            <child>
              <object class="GtkBox" id="hbox1">
                <property name="visible">1</property>
                <child>
                  <object class="GtkLabel" id="label2">
                    <property name="visible">1</property>
                    <property name="margin-start">6</property>
                  </object>
                  </child>
                <child>
                  <object class="GtkBox" id="vbox2">
                    <property name="visible">1</property>
                    <property name="orientation">vertical</property>
                    <property name="spacing">6</property>
                    <child>
                      <object class="GtkCheckButton" id="rbPercent200">
                        <property name="label" translatable="yes">200%</property>
                        <property name="width-request">146</property>
                        <property name="visible">1</property>
                        <property name="can-focus">1</property>
                        <property name="use-underline">1</property>
                        <property name="active">1</property>
                      </object>
                      </child>
                    <child>
                      <object class="GtkCheckButton" id="rbPercent100">
                        <property name="label" translatable="yes">100%</property>
                        <property name="visible">1</property>
                        <property name="can-focus">1</property>
                        <property name="use-underline">1</property>
                        <property name="group">rbPercent200</property>
                      </object>
                      </child>
                    <child>
                      <object class="GtkCheckButton" id="rbPercent75">
                        <property name="label" translatable="yes">75%</property>
                        <property name="visible">1</property>
                        <property name="can-focus">1</property>
                        <property name="use-underline">1</property>
                        <property name="group">rbPercent200</property>
                      </object>
                      </child>
                    <child>
                      <object class="GtkCheckButton" id="rbPageWidth">
                        <property name="label" translatable="yes">Page width</property>
                        <property name="visible">1</property>
                        <property name="can-focus">1</property>
                        <property name="use-underline">1</property>
                        <property name="group">rbPercent200</property>
                      </object>
                      </child>
                    <child>
                      <object class="GtkCheckButton" id="rbWholePage">
                        <property name="label" translatable="yes">Whole page</property>
                        <property name="visible">1</property>
                        <property name="can-focus">1</property>
                        <property name="use-underline">1</property>
                        <property name="active">1</property>
                        <property name="group">rbPercent200</property>
                      </object>
                      </child>
                    <child>
                      <object class="GtkCheckButton" id="rbPercent">
                        <property name="label" translatable="yes">Percent:</property>
                        <property name="visible">1</property>
                        <property name="can-focus">1</property>
                        <property name="use-underline">1</property>
                        <property name="group">rbPercent200</property>
                      </object>
                      </child>
                    <child>
                      <object class="GtkBox" id="hbox2">
                        <property name="visible">1</property>
                        <child>
                          <object class="GtkLabel" id="label3">
                            <property name="visible">1</property>
                            <property name="margin-start">3</property>
                            <property name="margin-end">3</property>
                          </object>
                          </child>
                        <child>
                          <object class="GtkSpinButton" id="sbPercent">
                            <property name="visible">1</property>
                            <property name="can-focus">1</property>
                            <property name="adjustment">adjustment1</property>
                            <property name="climb-rate">1</property>
                            <property name="numeric">1</property>
                          </object>
                          </child>
                      <property name="hexpand">1</property><property name="vexpand">1</property></object>
                      </child>
                  </object>
                  </child>
              <property name="hexpand">1</property><property name="vexpand">1</property></object>
              </child>
          </object>
          </child>
              <child>
          <object class="GtkBox" id="dialog-action_area1">
                    <property name="halign">end</property>
                    <property name="spacing">6</property>
                    <property name="margin-top">6</property>
                      <property name="visible">1</property>
                      <child>
                        <object class="GtkButton" id="closebutton1">
                          <property name="label">_Close</property>
                          <property name="use-underline">1</property>
                          <property name="visible">1</property>
                          <property name="can-focus">1</property>
                        </object>
                        </child>
                      <child>
                        <object class="GtkButton" id="applybutton1">
                          <property name="label">_Apply</property>
                          <property name="use-underline">1</property>
                          <property name="visible">1</property>
                          <property name="can-focus">1</property>
                        </object>
                        </child>
                    </object>
        </child>
</object>
    </child><action-widgets>
      <action-widget response="-5">closebutton1</action-widget>
      <action-widget response="-10">applybutton1</action-widget>
    </action-widgets>
  </object>
</interface>