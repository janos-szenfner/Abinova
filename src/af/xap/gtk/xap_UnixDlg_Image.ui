<?xml version='1.0' encoding='UTF-8'?>
<interface>
  <requires lib="gtk+" version="3.20" />
  <object class="GtkAdjustment" id="adjustment1">
    <property name="upper">100</property>
    <property name="value">1</property>
    <property name="step-increment">1</property>
    <property name="page-increment">10</property>
  </object>
  <object class="GtkAdjustment" id="adjustment2">
    <property name="upper">100</property>
    <property name="step-increment">1</property>
    <property name="page-increment">10</property>
  </object>
  <object class="GtkDialog" id="xap_UnixDlg_Image">
    <property name="title" translatable="yes">Image Properties</property>
    
        <child><object class="GtkBox" id="dialog-vbox1">
          <property name="margin-start">12</property>
          <property name="margin-end">12</property>
          <property name="margin-top">12</property>
          <property name="margin-bottom">12</property>
        <property name="visible">1</property>
        <property name="orientation">vertical</property>
        <child>
          <object class="GtkNotebook" id="notebook1">
            <property name="visible">1</property>
            <property name="can-focus">1</property>
            <child>
              <object class="GtkGrid" id="grDescTab">
                <property name="visible">1</property>
                <property name="row-spacing">6</property>
                <property name="column-spacing">12</property>
                <child>
                  <object class="GtkLabel" id="lbSize">
                    <property name="visible">1</property>
                    <property name="label" translatable="yes">&lt;b&gt;%s&lt;/b&gt;</property>
                    <property name="use-markup">1</property>
                    <property name="xalign">0</property>
                  <layout><property name="column">0</property><property name="row">0</property><property name="column-span">3</property></layout></object>
                  </child>
                <child>
                  <object class="GtkLabel" id="lbHeight">
                    <property name="visible">1</property>
                    <property name="margin-start">18</property>
                    <property name="label" translatable="yes">Height:</property>
                    <property name="xalign">0</property>
                  <layout><property name="column">0</property><property name="row">1</property></layout></object>
                  </child>
                <child>
                  <object class="GtkLabel" id="lbWidth">
                    <property name="visible">1</property>
                    <property name="margin-start">18</property>
                    <property name="label" translatable="yes">Width:</property>
                    <property name="xalign">0</property>
                  <layout><property name="column">0</property><property name="row">2</property></layout></object>
                  </child>
                <child>
                  <object class="GtkCheckButton" id="cbAspect">
                    <property name="label" translatable="yes">Preserve aspect ratio</property>
                    <property name="visible">1</property>
                    <property name="can-focus">1</property>
                    <property name="margin-start">18</property>
                    <property name="use-underline">1</property>
                  <layout><property name="column">0</property><property name="row">3</property><property name="column-span">3</property></layout></object>
                  </child>
                <child>
                  <object class="GtkEntry" id="edHeight">
                    <property name="visible">1</property>
                    <property name="can-focus">1</property>
                    <layout><property name="column">1</property><property name="row">1</property></layout></object>
                  </child>
                <child>
                  <object class="GtkEntry" id="edWidth">
                    <property name="visible">1</property>
                    <property name="can-focus">1</property>
                    <layout><property name="column">1</property><property name="row">2</property></layout></object>
                  </child>
                <child>
                  <object class="GtkSpinButton" id="sbHeight">
                    <property name="visible">1</property>
                    <property name="can-focus">1</property>
                    <property name="adjustment">adjustment2</property>
                    <property name="climb-rate">1</property>
                  <layout><property name="column">2</property><property name="row">1</property></layout></object>
                  </child>
                <child>
                  <object class="GtkSpinButton" id="sbWidth">
                    <property name="visible">1</property>
                    <property name="can-focus">1</property>
                    <property name="adjustment">adjustment1</property>
                    <property name="climb-rate">1</property>
                  <layout><property name="column">2</property><property name="row">2</property></layout></object>
                  </child>
                <child>
                  <object class="GtkLabel" id="lbImageDescription">
                    <property name="visible">1</property>
                    <property name="margin-top">12</property>
                    <property name="label" translatable="yes">&lt;b&gt;%s&lt;/b&gt;</property>
                    <property name="use-markup">1</property>
                    <property name="xalign">0</property>
                  <layout><property name="column">0</property><property name="row">4</property><property name="column-span">3</property></layout></object>
                  </child>
                <child>
                  <object class="GtkLabel" id="lbTitle">
                    <property name="visible">1</property>
                    <property name="margin-start">18</property>
                    <property name="label" translatable="yes">Title:</property>
                    <property name="xalign">0</property>
                  <layout><property name="column">0</property><property name="row">5</property></layout></object>
                  </child>
                <child>
                  <object class="GtkEntry" id="edTitle">
                    <property name="visible">1</property>
                    <property name="can-focus">1</property>
                    <layout><property name="column">1</property><property name="row">5</property><property name="column-span">2</property></layout></object>
                  </child>
                <child>
                  <object class="GtkLabel" id="lbDescription">
                    <property name="visible">1</property>
                    <property name="margin-start">18</property>
                    <property name="label" translatable="yes">Description:</property>
                    <property name="xalign">0</property>
                  <layout><property name="column">0</property><property name="row">6</property></layout></object>
                  </child>
                <child>
                  <object class="GtkEntry" id="edDescription">
                    <property name="visible">1</property>
                    <property name="can-focus">1</property>
                    <layout><property name="column">1</property><property name="row">6</property><property name="column-span">2</property></layout></object>
                  </child>
              </object>
            </child>
            <child type="tab">
              <object class="GtkLabel" id="lbDescTab">
                <property name="visible">1</property>
                <property name="label" translatable="yes">Description</property>
              </object>
              </child>
            <child>
              <object class="GtkGrid" id="grWrapping">
                <property name="visible">1</property>
                <property name="row-spacing">6</property>
                <child>
                  <object class="GtkLabel" id="lbTextWrapping">
                    <property name="visible">1</property>
                    <property name="label" translatable="yes">&lt;b&gt;%s&lt;/b&gt;</property>
                    <property name="use-markup">1</property>
                    <property name="xalign">0</property>
                  <layout><property name="column">0</property><property name="row">0</property></layout></object>
                  </child>
                <child>
                  <object class="GtkCheckButton" id="rbInLine">
                    <property name="label" translatable="yes">Image placed in line</property>
                    <property name="visible">1</property>
                    <property name="can-focus">1</property>
                    <property name="margin-start">18</property>
                    <property name="use-underline">1</property>
                    <property name="active">1</property>
                  <layout><property name="column">0</property><property name="row">1</property></layout></object>
                  </child>
                <child>
                  <object class="GtkCheckButton" id="rbNone">
                    <property name="label" translatable="yes">No Text wrapping</property>
                    <property name="visible">1</property>
                    <property name="can-focus">1</property>
                    <property name="margin-start">18</property>
                    <property name="use-underline">1</property>
                    <property name="group">rbInLine</property>
                  <layout><property name="column">0</property><property name="row">2</property></layout></object>
                  </child>
                <child>
                  <object class="GtkCheckButton" id="rbWrappedRight">
                    <property name="label" translatable="yes">Text wrapped to the right of Image</property>
                    <property name="visible">1</property>
                    <property name="can-focus">1</property>
                    <property name="margin-start">18</property>
                    <property name="use-underline">1</property>
                    <property name="group">rbInLine</property>
                  <layout><property name="column">0</property><property name="row">3</property></layout></object>
                  </child>
                <child>
                  <object class="GtkCheckButton" id="rbWrappedLeft">
                    <property name="label" translatable="yes">Text wrapped to Left of Image</property>
                    <property name="visible">1</property>
                    <property name="can-focus">1</property>
                    <property name="margin-start">18</property>
                    <property name="use-underline">1</property>
                    <property name="group">rbInLine</property>
                  <layout><property name="column">0</property><property name="row">4</property></layout></object>
                  </child>
                <child>
                  <object class="GtkCheckButton" id="rbWrappedBoth">
                    <property name="label" translatable="yes">Text wrapped on both sizes of the image</property>
                    <property name="visible">1</property>
                    <property name="can-focus">1</property>
                    <property name="margin-start">18</property>
                    <property name="use-underline">1</property>
                    <property name="group">rbInLine</property>
                  <layout><property name="column">0</property><property name="row">5</property></layout></object>
                  </child>
                <child>
                  <object class="GtkLabel" id="lbImagePlacement">
                    <property name="visible">1</property>
                    <property name="margin-top">12</property>
                    <property name="label" translatable="yes">&lt;b&gt;%s&lt;/b&gt;</property>
                    <property name="use-markup">1</property>
                    <property name="xalign">0</property>
                  <layout><property name="column">0</property><property name="row">6</property></layout></object>
                  </child>
                <child>
                  <object class="GtkCheckButton" id="rbPlaceParagraph">
                    <property name="label" translatable="yes">Position relative to nearest paragraph</property>
                    <property name="visible">1</property>
                    <property name="can-focus">1</property>
                    <property name="margin-start">18</property>
                    <property name="use-underline">1</property>
                    <property name="active">1</property>
                  <layout><property name="column">0</property><property name="row">7</property></layout></object>
                  </child>
                <child>
                  <object class="GtkCheckButton" id="rbPlaceColumn">
                    <property name="label" translatable="yes">Position relative to its column</property>
                    <property name="visible">1</property>
                    <property name="can-focus">1</property>
                    <property name="margin-start">18</property>
                    <property name="use-underline">1</property>
                    <property name="group">rbPlaceParagraph</property>
                  <layout><property name="column">0</property><property name="row">8</property></layout></object>
                  </child>
                <child>
                  <object class="GtkCheckButton" id="rbPlacePage">
                    <property name="label" translatable="yes">Position relative to its Page</property>
                    <property name="visible">1</property>
                    <property name="can-focus">1</property>
                    <property name="margin-start">18</property>
                    <property name="use-underline">1</property>
                    <property name="group">rbPlaceParagraph</property>
                  <layout><property name="column">0</property><property name="row">9</property></layout></object>
                  </child>
                <child>
                  <object class="GtkLabel" id="lbWrapType">
                    <property name="visible">1</property>
                    <property name="margin-top">12</property>
                    <property name="label" translatable="yes">&lt;b&gt;%s&lt;/b&gt;</property>
                    <property name="use-markup">1</property>
                    <property name="xalign">0</property>
                  <layout><property name="column">0</property><property name="row">10</property></layout></object>
                  </child>
                <child>
                  <object class="GtkCheckButton" id="rbTightWrap">
                    <property name="label" translatable="yes">Tight Wrap</property>
                    <property name="visible">1</property>
                    <property name="can-focus">1</property>
                    <property name="margin-start">18</property>
                    <property name="use-underline">1</property>
                    <property name="active">1</property>
                    <property name="group">rbSquareWrap</property>
                  <layout><property name="column">0</property><property name="row">12</property></layout></object>
                  </child>
                <child>
                  <object class="GtkCheckButton" id="rbSquareWrap">
                    <property name="label" translatable="yes">Square Wrap</property>
                    <property name="visible">1</property>
                    <property name="can-focus">1</property>
                    <property name="margin-start">18</property>
                    <property name="use-underline">1</property>
                  <layout><property name="column">0</property><property name="row">11</property></layout></object>
                  </child>
              </object>
              </child>
            <child type="tab">
              <object class="GtkLabel" id="lbWrapTab">
                <property name="visible">1</property>
                <property name="label" translatable="yes">Wrapping</property>
              </object>
              </child>
          </object>
          </child>
              <child>
          <object class="GtkBox" id="dialog-action_area1">
                    <property name="halign">end</property>
                    <property name="spacing">6</property>
                    <property name="margin-top">6</property>
                      <property name="visible">1</property>
                      <child>
                        <object class="GtkButton" id="btCancel">
                          <property name="label">_Cancel</property>
                          <property name="visible">1</property>
                          <property name="can-focus">1</property>
                        </object>
                        </child>
                      <child>
                        <object class="GtkButton" id="btOK">
                          <property name="label">_OK</property>
                          <property name="visible">1</property>
                          <property name="can-focus">1</property>
                        </object>
                        </child>
                    </object>
        </child>
</object>
    </child><action-widgets>
      <action-widget response="-6">btCancel</action-widget>
      <action-widget response="-5">btOK</action-widget>
    </action-widgets>
  </object>
</interface>