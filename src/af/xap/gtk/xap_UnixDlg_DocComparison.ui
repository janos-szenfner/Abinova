                <property name="margin-start">18</property>
                <property name="label" translatable="yes">%s</property>
                <property name="xalign">0</property>
              <layout><property name="column">0</property><property name="row">5</property></layout></object>
              </child>
            <child>
              <object class="GtkLabel" id="lbFormat">
