#!/bin/sh

G_DEBUG=gc-friendly
export G_DEBUG
G_SLICE=always-malloc
export G_SLICE
ABINOVA_TEST_SRC_DIR=@abs_top_srcdir@
export ABINOVA_TEST_SRC_DIR

# Pin the C locale: the first gtk_init_check() inside a test adopts the
# developer's environment locale via setlocale(LC_ALL,""), and on a
# comma-decimal desktop that leaks into every later suite (atof, %f)
LC_ALL=C
export LC_ALL

# Suppressions, mostly fontconfig — the init-time caches surface as
# LSan reports whose innermost frames do not symbolize, so the
# module-level patterns are what actually match
cat <<EOF > supp.txt
leak:FcConfig
leak:FcPattern
leak:FcValue
leak:FcFont
leak:FcLang
leak:FcInit
leak:libfontconfig
leak:libexpat
# GTK4 allocates small objects inside its own signal-dispatch machinery
# when _nullUpdate() pumps the main context during document load (one
# 32B object per run; every alloc frame inside libgtk/libgobject —
# ownership is inside the library, unreachable from first-party code).
leak:g_closure_invoke
EOF

LSAN_OPTIONS=suppressions=./supp.txt
export LSAN_OPTIONS

exec @abs_top_builddir@/libtool --mode=execute ./Abinova-test

