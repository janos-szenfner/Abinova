#!/bin/sh

G_DEBUG=gc-friendly
export G_DEBUG
G_SLICE=always-malloc
export G_SLICE
ABINOVA_TEST_SRC_DIR=@abs_top_srcdir@
export ABINOVA_TEST_SRC_DIR

# Suppressions, mostly fontconfig
cat <<EOF > supp.txt
leak:FcConfig
leak:FcPattern
leak:FcValue
leak:FcFont
leak:FcLang
EOF

LSAN_OPTIONS=suppressions=./supp.txt
export LSAN_OPTIONS

exec @abs_top_builddir@/libtool --mode=execute ./Abinova-test

