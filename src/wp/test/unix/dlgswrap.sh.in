#!/bin/sh

# GTK dialog smoke harness (TST08): open every dialog registered in
# the AP_UnixDialogFactory table and fail on GTK criticals or crashes.
#
# Needs a display: prefers xvfb-run whenever it is installed so the
# suite never pops windows on the user's real session, and falls back
# to the live DISPLAY/WAYLAND_DISPLAY only when xvfb-run is absent.
# Set ABINOVA_TEST_LIVE_DISPLAY=1 to force the live display for legs
# that genuinely need a real session.  Exits 77 (SKIP) when no usable
# display exists.
# Each dialog runs in its own dialog-smoke process under `timeout` so
# a hang or segfault is attributed to that dialog id.

ABINOVA_TEST_SRC_DIR=@abs_top_srcdir@
export ABINOVA_TEST_SRC_DIR

cd @abs_top_builddir@/src/wp/test || exit 1
BIN="./dialog-smoke"
LIBTOOL="@abs_top_builddir@/libtool --mode=execute"

if [ -z "${TST08_INNER:-}" ]; then
	if [ -n "${ABINOVA_TEST_LIVE_DISPLAY:-}" ]; then
		: # caller asked for the real session display
	elif command -v xvfb-run >/dev/null 2>&1; then
		# Pin the X11 backend, not just strip the hints: GTK4's
		# wayland backend falls back to the "wayland-0" socket in
		# XDG_RUNTIME_DIR even with WAYLAND_DISPLAY unset, so an
		# unset alone still lets dialogs open on a live compositor
		# (FRZ06's transient id-1005 failure: wl_surface protocol
		# error from the real session under xvfb).
		unset WAYLAND_DISPLAY
		GDK_BACKEND=x11
		export GDK_BACKEND
		TST08_INNER=1
		export TST08_INNER
		# Absolute path: the cd above already moved us off the
		# caller's CWD, so a relative $0 would not resolve here.
		exec xvfb-run -a "@abs_top_builddir@/src/wp/test/unix/dlgswrap.sh"
	fi
	if [ -z "${DISPLAY:-}" ] && [ -z "${WAYLAND_DISPLAY:-}" ]; then
		echo "SKIP: no usable display" >&2
		exit 77
	fi
fi

# GLib structured logging can emit DEBUG lines on stdout; keep only
# pure-numeric lines from --list
ids=$($LIBTOOL $BIN --list 2>/dev/null | grep -E '^[0-9]+$') || {
	echo "FAIL: dialog-smoke --list exited $?" >&2
	exit 1
}

# Expected failures — dialogs with known, documented defects.  Each
# entry needs a FIXME-worthy reason; new ids may NOT be added here to
# silence the test.
#  1018 AP_UnixDialog_Styles — emits a single
#       g_object_unref("G_IS_OBJECT failed") critical inside GTK4.14's
#       model teardown when the window is destroyed; dialog is fully
#       functional, teardown-only noise.
XFAIL_IDS=" 1018 "

fails=0
xfails=0
total=0
for id in $ids; do
	total=$((total + 1))
	if timeout 40 $LIBTOOL $BIN --id "$id" >/dev/null 2>&1; then
		echo "ok: dialog id $id"
	else
		rc=$?
		if [ "$rc" -eq 77 ]; then
			echo "skip: dialog id $id (no interactive context)"
		elif [ "${XFAIL_IDS#* $id }" != "$XFAIL_IDS" ]; then
			echo "xfail: dialog id $id (rc=$rc)"
			xfails=$((xfails + 1))
		else
			echo "FAIL: dialog id $id (rc=$rc)"
			fails=$((fails + 1))
		fi
	fi
done

echo "dialog smoke: $((total - fails - xfails))/$total dialogs clean, $xfails xfail"
[ "$fails" -eq 0 ]
