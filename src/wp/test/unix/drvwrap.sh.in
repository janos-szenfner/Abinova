#!/bin/sh

# Scripted-interaction coverage driver (COV12): open every registered
# dialog AND exercise its widgets (pages, popovers, list selections,
# entries, buttons), then drive the main window's ribbon/panes and the
# AbiWidget API.  Complements dlgswrap.sh (instantiation smoke only).
#
# Needs a display: prefers xvfb-run whenever it is installed so the
# suite never pops windows on the user's real session, and falls back
# to the live DISPLAY/WAYLAND_DISPLAY only when xvfb-run is absent.
# Set ABINOVA_TEST_LIVE_DISPLAY=1 to force the live display for legs
# that genuinely need a real session (e.g. portal file-chooser runs).
# Exits 77 (SKIP) when no usable display exists.
# Each dialog runs in its own ui-drive process under `timeout` so a
# hang or segfault is attributed to that dialog id.  A timeout (rc
# 124) is reported but NOT a failure — driven widgets can legitimately
# block on session services; crashes are failures.
#
# Buttons are activated for real, so the driven document is a scratch
# copy staged under $TMPDIR.

ABINOVA_TEST_SRC_DIR=@abs_top_srcdir@
export ABINOVA_TEST_SRC_DIR

cd @abs_top_builddir@/src/wp/test || exit 1
BIN="./ui-drive"
LIBTOOL="@abs_top_builddir@/libtool --mode=execute"

if [ -z "${COV12_INNER:-}" ]; then
	if [ -n "${ABINOVA_TEST_LIVE_DISPLAY:-}" ]; then
		: # caller asked for the real session display
	elif command -v xvfb-run >/dev/null 2>&1; then
		# Pin the X11 backend, not just strip the hints: GTK4's
		# wayland backend falls back to the "wayland-0" socket in
		# XDG_RUNTIME_DIR even with WAYLAND_DISPLAY unset, so an
		# unset alone still lets dialogs open on a live compositor
		# (FRZ06's transient id-1005 failure: wl_surface protocol
		# error from the real session under xvfb).
		unset WAYLAND_DISPLAY
		GDK_BACKEND=x11
		export GDK_BACKEND
		COV12_INNER=1
		export COV12_INNER
		# Absolute path: the cd above already moved us off the
		# caller's CWD, so a relative $0 would not resolve here.
		exec xvfb-run -a "@abs_top_builddir@/src/wp/test/unix/drvwrap.sh"
	fi
	if [ -z "${DISPLAY:-}" ] && [ -z "${WAYLAND_DISPLAY:-}" ]; then
		echo "SKIP: no usable display" >&2
		exit 77
	fi
fi

scratch="${TMPDIR:-/tmp}/ui-drive-$$.abw"
cp "$ABINOVA_TEST_SRC_DIR/test/wp/cov07/rich.abw" "$scratch" || {
	echo "FAIL: cannot stage scratch doc" >&2
	exit 1
}
UI_DRIVE_DOC="$scratch"
export UI_DRIVE_DOC

# GLib structured logging can emit DEBUG lines on stdout; keep only
# pure-numeric lines from --list
ids=$($LIBTOOL $BIN --list 2>/dev/null | grep -E '^[0-9]+$') || {
	echo "FAIL: ui-drive --list exited $?" >&2
	exit 1
}

# Expected failures — dialogs whose failure is inside system code the
# driver cannot guard.  Each entry needs a documented reason; new ids
# may NOT be added here to silence the test.
#  8    XAP_DIALOG_ID_PRINT — GTK4's GtkPrintUnixDialog spins up the
#       print machinery's session D-Bus/CUPS queries at construction
#       and segfaults inside libgio here before the driver ever sees a
#       widget; the driver never descends into system dialogs, so the
#       fault is outside its interact guard.  Nothing in Abinova code
#       is at fault.
XFAIL_IDS=" 8 "

fails=0
skips=0
xfails=0
total=0
for id in $ids; do
	total=$((total + 1))
	# -k: a hung leg may deadlock inside the gcov dump the SIGTERM
	# handler runs — escalate to SIGKILL so the suite cannot wedge
	timeout -k 15 90 $LIBTOOL $BIN --id "$id" >/dev/null 2>&1
	rc=$?
	case "$rc" in
		0) echo "ok: dialog id $id" ;;
		77) echo "skip: dialog id $id (no interactive context)"
		    skips=$((skips + 1)) ;;
		124|137) echo "timeout: dialog id $id" ;;
		*) if [ "${XFAIL_IDS#* $id }" != "$XFAIL_IDS" ]; then
		       echo "xfail: dialog id $id (rc=$rc)"
		       xfails=$((xfails + 1))
		   else
		       echo "FAIL: dialog id $id (rc=$rc)"
		       fails=$((fails + 1))
		   fi ;;
	esac
done

timeout -k 15 300 $LIBTOOL $BIN --frame >/dev/null 2>&1 && \
	echo "ok: frame drive" || echo "timeout/fail: frame drive"

timeout -k 15 180 $LIBTOOL $BIN --abi >/dev/null 2>&1 && \
	echo "ok: abiwidget drive" || echo "timeout/fail: abiwidget drive"

# COV13: event/menu/graphics leg — menu dispatch, input-handler
# entry paths, cairo image/media fixtures on a live frame.  Runs
# under xvfb-run when available, else the live display like the
# other legs.  Best-effort: a timeout is tolerated.
timeout -k 15 300 $LIBTOOL $BIN --ev >/dev/null 2>&1 && \
	echo "ok: ev drive" || echo "timeout/fail: ev drive"

# RUL01: ruler pointer-drag leg — injects real pointer events with
# XTest on the live frame: click-adds a tab stop, drags it off the
# band (delete gesture), drags an indent/margin marker horizontally
# while the pointer strays off the band (must apply at the tracked
# position), and double-clicks for the Paragraph dialog.  Needs the
# X11 backend + libXtst; the leg exits 77 on other displays.
ruler_log="${TMPDIR:-/tmp}/ui-drive-ruler-$$.log"
timeout -k 15 120 $LIBTOOL $BIN --ruler >"$ruler_log" 2>&1
ruler_rc=$?
case "$ruler_rc" in
	0)   echo "ok: ruler drag drive" ;;
	77)  echo "skip: ruler drag drive (no X11/XTest)" ;;
	*)   echo "FAIL: ruler drag drive (rc=$ruler_rc)"
	     tail -20 "$ruler_log" | sed 's/^/  /' >&2
	     fails=$((fails + 1)) ;;
esac
rm -f "$ruler_log"

# COV14: text/fmt/gtk leg — selection handles on the document
# GtkOverlay, the paste-options tag, and the text/image/frame drag
# paths (temp file, content providers, gdk_drag_begin).  Wayland-
# focused: prefer GDK's wayland backend when a compositor is live so
# the overlay/drag/clipboard code runs through gdk_wayland_*; fall
# back to the default backend if that fails (e.g. stale socket).
fmt_rc=77
if [ -n "${WAYLAND_DISPLAY:-}" ]; then
	GDK_BACKEND=wayland timeout -k 15 300 $LIBTOOL $BIN --fmt \
		>/dev/null 2>&1
	fmt_rc=$?
fi
if [ "$fmt_rc" -ne 0 ]; then
	timeout -k 15 300 $LIBTOOL $BIN --fmt >/dev/null 2>&1
	fmt_rc=$?
fi
[ "$fmt_rc" -eq 0 ] && echo "ok: fmt drive" || \
	echo "timeout/fail: fmt drive (rc=$fmt_rc)"

# TST12: heartbeat freeze leg — a 40ms timeout source tracks the gap
# between main-context services while the driver scripts the FRZ01-03
# operations (doc load, burst typing, scrolling, autosave ticks,
# dialogs, an async media embed, a .doc import).  A synchronous stall
# — a usleep, a blocking whole-file read, a serializing loop — fails
# the leg.  Unlike the dialog legs a heartbeat trip IS the failure, so
# any nonzero exit counts.  Fresh scratch: the frame leg's widget walk
# can trigger a document save, and when it hits the wrapper timeout
# the kill leaves the shared file truncated (load err -304 downstream)
freeze_scratch="${TMPDIR:-/tmp}/ui-drive-freeze-$$.abw"
cp "$ABINOVA_TEST_SRC_DIR/test/wp/cov07/rich.abw" "$freeze_scratch" || {
	echo "FAIL: cannot stage freeze scratch doc" >&2
	exit 1
}
freeze_log="${TMPDIR:-/tmp}/ui-drive-freeze-$$.log"
UI_DRIVE_DOC="$freeze_scratch" timeout -k 15 240 $LIBTOOL $BIN \
	--freeze >"$freeze_log" 2>&1
freeze_rc=$?
case "$freeze_rc" in
	0)   echo "ok: freeze heartbeat drive" ;;
	77)  echo "skip: freeze heartbeat drive (no interactive context)" ;;
	*)   echo "FAIL: freeze heartbeat drive (rc=$freeze_rc)"
	     tail -20 "$freeze_log" | sed 's/^/  /' >&2
	     fails=$((fails + 1)) ;;
esac
rm -f "$freeze_log" "$freeze_scratch"

# TOC01: TOC context-menu regression leg — opens the real ContextTOC
# popover through contextTOC's nested modal loop and activates
# "Update Table" while the menu is still mapped, on a one-page
# fixture and a generated multi-page doc, then re-updates and undoes.
# The original bug wedged the main loop hard, so any nonzero exit
# (including a timeout) is a failure.
toc_log="${TMPDIR:-/tmp}/ui-drive-toc-$$.log"
timeout -k 15 120 $LIBTOOL $BIN --toc >"$toc_log" 2>&1
toc_rc=$?
case "$toc_rc" in
	0)   echo "ok: toc context-menu drive" ;;
	77)  echo "skip: toc context-menu drive (no interactive context)" ;;
	*)   echo "FAIL: toc context-menu drive (rc=$toc_rc)"
	     tail -20 "$toc_log" | sed 's/^/  /' >&2
	     fails=$((fails + 1)) ;;
esac
rm -f "$toc_log"

# TRACK01: markup-mode selector leg — clicks the real
# Display-for-Review popover rows (Simple / All / No Markup /
# Original) through two rounds and asserts the view flag combo, row
# and button sensitivity, popover re-open, check-mark position,
# caption text and revision-data preservation on every transition.
# A stuck selector is the regression being guarded, so any nonzero
# exit (including a timeout) is a failure.
markup_log="${TMPDIR:-/tmp}/ui-drive-markup-$$.log"
timeout -k 15 120 $LIBTOOL $BIN --markup >"$markup_log" 2>&1
markup_rc=$?
case "$markup_rc" in
	0)   echo "ok: markup mode drive" ;;
	77)  echo "skip: markup mode drive (no interactive context)" ;;
	*)   echo "FAIL: markup mode drive (rc=$markup_rc)"
	     tail -20 "$markup_log" | sed 's/^/  /' >&2
	     fails=$((fails + 1)) ;;
esac
rm -f "$markup_log"

# TST03: popover/menu lifecycle leg — opens every ribbon popover on
# the rich fixture, activates each row, asserts it stays sensitive
# and the popover re-opens; check popovers (markup/zoom/toggles/window
# list) verify the tick lands on the clicked row, then the contextText/
# contextTOC/contextImage edit methods run the nested-loop popup path
# with a real item activation.  A stuck row is the regression being
# guarded, so any nonzero exit (including a timeout) is a failure.
# Fresh scratch like the freeze leg — a killed earlier leg must not
# poison the fixture this leg loads.
pop_scratch="${TMPDIR:-/tmp}/ui-drive-popovers-$$.abw"
cp "$ABINOVA_TEST_SRC_DIR/test/wp/cov07/rich.abw" "$pop_scratch" || {
	echo "FAIL: cannot stage popovers scratch doc" >&2
	exit 1
}
pop_log="${TMPDIR:-/tmp}/ui-drive-popovers-$$.log"
UI_DRIVE_DOC="$pop_scratch" timeout -k 15 1200 $LIBTOOL $BIN \
	--popovers >"$pop_log" 2>&1
pop_rc=$?
case "$pop_rc" in
	0)   echo "ok: popover lifecycle drive" ;;
	77)  echo "skip: popover lifecycle drive (no interactive context)" ;;
	*)   echo "FAIL: popover lifecycle drive (rc=$pop_rc)"
	     tail -20 "$pop_log" | sed 's/^/  /' >&2
	     fails=$((fails + 1)) ;;
esac
rm -f "$pop_log" "$pop_scratch"

rm -f "$scratch" /tmp/ui-drive-abi.abw /tmp/ui-drive-red.png \
	"${TMPDIR:-/tmp}/ui-drive-toc-multi.abw" \
	"${TMPDIR:-/tmp}/ui-drive-media.abwn" "${TMPDIR:-/tmp}/ui-drive-blip.abw" \
	"${TMPDIR:-/tmp}/ui-drive-fmt-blip.abw" \
	"${TMPDIR:-/tmp}/ui-drive-freeze-embed.bin" \
	"${TMPDIR:-/tmp}/ui-drive-pop-blip.abw"

echo "dialog drive: $((total - fails - skips - xfails))/$total dialogs clean, $skips skipped, $xfails xfail"
[ "$fails" -eq 0 ]
