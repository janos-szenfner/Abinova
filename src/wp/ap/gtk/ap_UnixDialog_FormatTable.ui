<?xml version='1.0' encoding='UTF-8'?>
<interface>
  <requires lib="gtk+" version="3.20" />
  <object class="GtkDialog" id="ap_UnixDialog_FormatTable">
    <property name="visible">1</property>
    <property name="title" translatable="yes">Format Table</property>
    <property name="resizable">0</property>
    
        <child><object class="GtkBox" id="vbDialog">
          <property name="margin-start">12</property>
          <property name="margin-end">12</property>
          <property name="margin-top">12</property>
          <property name="margin-bottom">12</property>
        <property name="visible">1</property>
        <property name="orientation">vertical</property>
        <property name="spacing">2</property>
        <child>
          <object class="GtkGrid" id="grContent">
            <property name="visible">1</property>
            <property name="row-spacing">6</property>
            <property name="column-spacing">12</property>
            <child>
              <object class="GtkGrid" id="grBorder">
                <property name="visible">1</property>
                <property name="row-spacing">6</property>
                <property name="column-spacing">12</property>
                <child>
                  <object class="GtkLabel" id="lbBorder">
                    <property name="visible">1</property>
                    <property name="label" translatable="yes">&lt;b&gt;%s&lt;/b&gt;</property>
                    <property name="use-markup">1</property>
                    <property name="xalign">0</property>
                  <layout><property name="column">0</property><property name="row">0</property><property name="column-span">2</property></layout></object>
                  </child>
                <child>
                  <object class="GtkLabel" id="lbBorderColor">
                    <property name="visible">1</property>
                    <property name="margin-start">18</property>
                    <property name="label" translatable="yes">Color:</property>
                    <property name="xalign">0</property>
                  <layout><property name="column">0</property><property name="row">1</property></layout></object>
                  </child>
                <child>
                  <object class="GtkColorButton" id="cbtBorderColorButton">
                    <property name="visible">1</property>
                    <property name="can-focus">1</property>
                  <layout><property name="column">1</property><property name="row">1</property></layout></object>
                  </child>
                <child>
                  <object class="GtkLabel" id="lbBorderThickness">
                    <property name="visible">1</property>
                    <property name="margin-start">18</property>
                    <property name="label" translatable="yes">Thickness:</property>
                    <property name="xalign">0</property>
                  <layout><property name="column">0</property><property name="row">2</property></layout></object>
                  </child>
                <child>
                  <object class="GtkComboBox" id="omBorderThickness">
                    <property name="visible">1</property>
                  <layout><property name="column">1</property><property name="row">2</property></layout></object>
                  </child>
                <child>
                  <object class="GtkLabel" id="lbBackground">
                    <property name="visible">1</property>
                    <property name="margin-top">12</property>
                    <property name="label" translatable="yes">&lt;b&gt;%s&lt;/b&gt;</property>
                    <property name="use-markup">1</property>
                    <property name="xalign">0</property>
                  <layout><property name="column">0</property><property name="row">3</property><property name="column-span">2</property></layout></object>
                  </child>
                <child>
                  <object class="GtkLabel" id="lbBackgroundColor">
                    <property name="visible">1</property>
                    <property name="margin-start">18</property>
                    <property name="label" translatable="yes">Color:</property>
                    <property name="xalign">0</property>
                  <layout><property name="column">0</property><property name="row">4</property></layout></object>
                  </child>
                <child>
                  <object class="GtkColorButton" id="cbtBackgroundColorButton">
                    <property name="visible">1</property>
                    <property name="can-focus">1</property>
                  <layout><property name="column">1</property><property name="row">4</property></layout></object>
                  </child>
                <child>
                  <object class="GtkLabel" id="lbSetImageBackground">
                    <property name="visible">1</property>
                    <property name="margin-top">12</property>
                    <property name="label" translatable="yes">&lt;b&gt;%s&lt;/b&gt;</property>
                    <property name="use-markup">1</property>
                    <property name="xalign">0</property>
                  <layout><property name="column">0</property><property name="row">5</property><property name="column-span">2</property></layout></object>
                  </child>
                <child>
                  <object class="GtkButton" id="btSelectImage">
                    <property name="visible">1</property>
                    <property name="can-focus">1</property>
                    <property name="margin-start">18</property>
                    <child>
                      <object class="GtkBox" id="alignment1">
                        <property name="visible">1</property>
                        <child>
                          <object class="GtkBox" id="hbox1">
                            <property name="visible">1</property>
                            <property name="spacing">2</property>
                            <child>
                              <object class="GtkImage" id="image1">
                                <property name="visible">1</property>
                              </object>
                              </child>
                            <child>
                              <object class="GtkLabel" id="lbSelectImage">
                                <property name="visible">1</property>
                                <property name="label" translatable="yes">Select Image from file</property>
                                <property name="use-underline">1</property>
                              </object>
                              </child>
                          </object>
                        </child>
                      </object>
                    </child>
                  <layout><property name="column">0</property><property name="row">6</property><property name="column-span">2</property></layout></object>
                  </child>
                <child>
                  <object class="GtkButton" id="btNoImageBackground">
                    <property name="visible">1</property>
                    <property name="can-focus">1</property>
                    <property name="margin-start">18</property>
                    <child>
                      <object class="GtkBox" id="alignment2">
                        <property name="visible">1</property>
                        <child>
                          <object class="GtkBox" id="hbox2">
                            <property name="visible">1</property>
                            <property name="spacing">2</property>
                            <child>
                              <object class="GtkImage" id="image2">
                                <property name="visible">1</property>
                              </object>
                              </child>
                            <child>
                              <object class="GtkLabel" id="lbSetNoImage">
                                <property name="visible">1</property>
                                <property name="label" translatable="yes">Set No Image</property>
                                <property name="use-underline">1</property>
                              </object>
                              </child>
                          </object>
                        </child>
                      </object>
                    </child>
                  <layout><property name="column">0</property><property name="row">7</property><property name="column-span">2</property></layout></object>
                  </child>
              <layout><property name="column">0</property><property name="row">0</property><property name="row-span">3</property></layout></object>
              </child>
            <child>
              <object class="GtkGrid" id="grPreview">
                <property name="visible">1</property>
                <property name="row-spacing">6</property>
                <property name="column-spacing">6</property>
                <child>
                  <object class="GtkLabel" id="lbPreview">
                    <property name="visible">1</property>
                    <property name="label" translatable="yes">&lt;b&gt;%s&lt;/b&gt;</property>
                    <property name="use-markup">1</property>
                    <property name="xalign">0</property>
                  <layout><property name="column">0</property><property name="row">0</property><property name="column-span">3</property></layout></object>
