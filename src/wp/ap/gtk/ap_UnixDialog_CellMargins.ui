<?xml version='1.0' encoding='UTF-8'?>
<interface>
  <requires lib="gtk" version="4.0" />
  <object class="GtkAdjustment" id="adjTop">
    <property name="lower">0</property>
    <property name="upper">100</property>
    <property name="value">0</property>
    <property name="step-increment">0.05</property>
    <property name="page-increment">0.2</property>
  </object>
  <object class="GtkAdjustment" id="adjBottom">
    <property name="lower">0</property>
    <property name="upper">100</property>
    <property name="value">0</property>
    <property name="step-increment">0.05</property>
    <property name="page-increment">0.2</property>
  </object>
  <object class="GtkAdjustment" id="adjLeft">
    <property name="lower">0</property>
    <property name="upper">100</property>
    <property name="value">0</property>
    <property name="step-increment">0.05</property>
    <property name="page-increment">0.2</property>
  </object>
  <object class="GtkAdjustment" id="adjRight">
    <property name="lower">0</property>
    <property name="upper">100</property>
    <property name="value">0</property>
    <property name="step-increment">0.05</property>
    <property name="page-increment">0.2</property>
  </object>
  <object class="GtkDialog" id="ap_UnixDialog_CellMargins">
    <property name="title" translatable="yes">Cell Margins</property>
    <property name="resizable">0</property>
    <property name="modal">1</property>
        <child><object class="GtkBox" id="vbDialog">
          <property name="margin-start">12</property>
          <property name="margin-end">12</property>
          <property name="margin-top">12</property>
          <property name="margin-bottom">12</property>
        <property name="visible">1</property>
        <property name="orientation">vertical</property>
        <property name="spacing">6</property>
        <child>
          <object class="GtkGrid" id="grContent">
            <property name="visible">1</property>
            <property name="row-spacing">6</property>
            <property name="column-spacing">12</property>
            <child>
              <object class="GtkLabel" id="lbTop">
                <property name="visible">1</property>
                <property name="label" translatable="yes">_Top:</property>
                <property name="use-underline">1</property>
                <property name="xalign">0</property>
              <layout><property name="column">0</property><property name="row">0</property></layout></object>
              </child>
            <child>
              <object class="GtkSpinButton" id="sbTop">
                <property name="width-request">96</property>
                <property name="visible">1</property>
                <property name="can-focus">1</property>
                <property name="adjustment">adjTop</property>
                <property name="climb-rate">0.05</property>
                <property name="digits">2</property>
                <property name="numeric">1</property>
              <layout><property name="column">1</property><property name="row">0</property></layout></object>
              </child>
            <child>
              <object class="GtkLabel" id="lbBottom">
                <property name="visible">1</property>
                <property name="label" translatable="yes">_Bottom:</property>
                <property name="use-underline">1</property>
                <property name="xalign">0</property>
              <layout><property name="column">0</property><property name="row">1</property></layout></object>
              </child>
            <child>
              <object class="GtkSpinButton" id="sbBottom">
                <property name="width-request">96</property>
                <property name="visible">1</property>
                <property name="can-focus">1</property>
                <property name="adjustment">adjBottom</property>
                <property name="climb-rate">0.05</property>
                <property name="digits">2</property>
                <property name="numeric">1</property>
              <layout><property name="column">1</property><property name="row">1</property></layout></object>
              </child>
            <child>
              <object class="GtkLabel" id="lbLeft">
                <property name="visible">1</property>
                <property name="label" translatable="yes">_Left:</property>
                <property name="use-underline">1</property>
                <property name="xalign">0</property>
              <layout><property name="column">0</property><property name="row">2</property></layout></object>
              </child>
            <child>
              <object class="GtkSpinButton" id="sbLeft">
                <property name="width-request">96</property>
                <property name="visible">1</property>
                <property name="can-focus">1</property>
                <property name="adjustment">adjLeft</property>
                <property name="climb-rate">0.05</property>
                <property name="digits">2</property>
                <property name="numeric">1</property>
              <layout><property name="column">1</property><property name="row">2</property></layout></object>
              </child>
            <child>
              <object class="GtkLabel" id="lbRight">
                <property name="visible">1</property>
                <property name="label" translatable="yes">_Right:</property>
                <property name="use-underline">1</property>
                <property name="xalign">0</property>
              <layout><property name="column">0</property><property name="row">3</property></layout></object>
              </child>
            <child>
              <object class="GtkSpinButton" id="sbRight">
                <property name="width-request">96</property>
                <property name="visible">1</property>
                <property name="can-focus">1</property>
                <property name="adjustment">adjRight</property>
                <property name="climb-rate">0.05</property>
                <property name="digits">2</property>
                <property name="numeric">1</property>
              <layout><property name="column">1</property><property name="row">3</property></layout></object>
              </child>
            <child>
              <object class="GtkLabel" id="lbUnit">
                <property name="visible">1</property>
                <property name="label">in</property>
                <property name="xalign">0</property>
              <layout><property name="column">2</property><property name="row">0</property><property name="row-span">4</property></layout></object>
              </child>
          </object>
          </child>
              <child>
          <object class="GtkBox" id="aaDialog">
                    <property name="halign">end</property>
                    <property name="spacing">6</property>
                    <property name="margin-top">6</property>
                      <property name="visible">1</property>
                      <child>
                        <object class="GtkButton" id="btCancel">
                          <property name="label">_Cancel</property>
                          <property name="use-underline">1</property>
                          <property name="visible">1</property>
                          <property name="can-focus">1</property>
                        </object>
                        </child>
                      <child>
                        <object class="GtkButton" id="btOK">
                          <property name="label">OK</property>
                          <property name="visible">1</property>
                          <property name="can-focus">1</property>
                        </object>
                        </child>
                    </object>
        </child>
</object>
    </child><action-widgets>
      <action-widget response="-6">btCancel</action-widget>
      <action-widget response="1">btOK</action-widget>
    </action-widgets>
  </object>
</interface>
