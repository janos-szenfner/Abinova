<?xml version='1.0' encoding='UTF-8'?>
<interface>
  <requires lib="gtk+" version="3.20" />
  <object class="GtkDialog" id="ap_UnixDialog_Border_Shading">
    <property name="visible">1</property>
    <property name="title" translatable="yes">Format Table</property>
    <property name="resizable">0</property>
    
        <child><object class="GtkBox" id="vbDialog">
          <property name="margin-start">12</property>
          <property name="margin-end">12</property>
          <property name="margin-top">12</property>
          <property name="margin-bottom">12</property>
        <property name="visible">1</property>
        <property name="orientation">vertical</property>
        <property name="spacing">2</property>
        <child>
          <object class="GtkGrid" id="grContent">
            <property name="visible">1</property>
            <property name="vexpand">1</property>
            <property name="row-spacing">6</property>
            <property name="column-spacing">12</property>
            <child>
              <object class="GtkLabel" id="lbBorder">
                <property name="visible">1</property>
                <property name="label" translatable="yes">&lt;b&gt;%s&lt;/b&gt;</property>
                <property name="use-markup">1</property>
                <property name="xalign">0</property>
              <layout><property name="column">0</property><property name="row">0</property><property name="column-span">2</property></layout></object>
              </child>
            <child>
              <object class="GtkLabel" id="lbPreview">
                <property name="visible">1</property>
                <property name="label" translatable="yes">&lt;b&gt;%s&lt;/b&gt;</property>
                <property name="use-markup">1</property>
                <property name="xalign">0</property>
              <layout><property name="column">2</property><property name="row">0</property></layout></object>
              </child>
            <child>
              <object class="GtkLabel" id="lbBorderColor">
                <property name="visible">1</property>
                <property name="margin-start">18</property>
                <property name="label" translatable="yes">Color:</property>
                <property name="xalign">0</property>
              <layout><property name="column">0</property><property name="row">1</property></layout></object>
              </child>
            <child>
              <object class="GtkColorButton" id="cbtBorderColorButton">
                <property name="visible">1</property>
                <property name="can-focus">1</property>
                <signal name="color-set" handler="on_cbtBorderColorButton_color_set" swapped="no" />
              <layout><property name="column">1</property><property name="row">1</property></layout></object>
              </child>
            <child>
              <object class="GtkLabel" id="lbBorderThickness">
                <property name="visible">1</property>
                <property name="margin-start">18</property>
                <property name="label" translatable="yes">Thickness:</property>
                <property name="xalign">0</property>
              <layout><property name="column">0</property><property name="row">2</property></layout></object>
              </child>
            <child>
              <object class="GtkComboBox" id="omBorderThickness">
                <property name="visible">1</property>
              <layout><property name="column">1</property><property name="row">2</property></layout></object>
              </child>
            <child>
              <object class="GtkLabel" id="lblBorderStyle">
                <property name="visible">1</property>
                <property name="margin-start">18</property>
                <property name="label" translatable="yes">Style
</property>
                <property name="xalign">0</property>
              <layout><property name="column">0</property><property name="row">3</property></layout></object>
              </child>
            <child>
              <object class="GtkComboBox" id="cmbBorderStyle">
                <property name="visible">1</property>
              <layout><property name="column">1</property><property name="row">3</property></layout></object>
              </child>
            <child>
              <object class="GtkLabel" id="lbShading">
                <property name="visible">1</property>
                <property name="margin-top">12</property>
                <property name="label" translatable="yes">&lt;b&gt;%s&lt;/b&gt;</property>
                <property name="use-markup">1</property>
                <property name="xalign">0</property>
              <layout><property name="column">0</property><property name="row">4</property><property name="column-span">2</property></layout></object>
              </child>
            <child>
              <object class="GtkCheckButton" id="cbShadingEnable">
                <property name="label" translatable="yes">Enable Shading</property>
                <property name="visible">1</property>
                <property name="can-focus">1</property>
                <property name="margin-start">18</property>
                <property name="use-underline">1</property>
              <layout><property name="column">0</property><property name="row">5</property><property name="column-span">2</property></layout></object>
              </child>
            <child>
              <object class="GtkLabel" id="lbShadingColor">
                <property name="visible">1</property>
                <property name="margin-start">18</property>
                <property name="label" translatable="yes">Color:</property>
                <property name="xalign">0</property>
              <layout><property name="column">0</property><property name="row">6</property></layout></object>
              </child>
            <child>
              <object class="GtkLabel" id="lblShadingOffset">
                <property name="visible">1</property>
                <property name="margin-start">18</property>
                <property name="label" translatable="yes">Offset
</property>
                <property name="xalign">0</property>
              <layout><property name="column">0</property><property name="row">7</property></layout></object>
              </child>
            <child>
              <object class="GtkColorButton" id="cbtShadingColorButton">
                <property name="visible">1</property>
                <property name="can-focus">1</property>
                <property name="receives-default">1</property>
              <layout><property name="column">1</property><property name="row">6</property></layout></object>
              </child>
            <child>
              <object class="GtkComboBox" id="cmbShadingOffset">
                <property name="visible">1</property>
              <layout><property name="column">1</property><property name="row">7</property></layout></object>
              </child>
            <child>
              <object class="GtkGrid" id="grPreview">
                <property name="visible">1</property>
                <property name="valign">start</property>
                <property name="margin-start">18</property>
                <property name="row-spacing">6</property>
                <property name="column-spacing">6</property>
                <child>
                  <object class="GtkToggleButton" id="tbBorderTop">
                    <property name="width-request">25</property>
                    <property name="height-request">25</property>
                    <property name="visible">1</property>
                    <property name="halign">center</property>
                  <layout><property name="column">1</property><property name="row">0</property></layout></object>
                  </child>
                <child>
                  <object class="GtkDrawingArea" id="daPreview">
                    <property name="width-request">146</property>
                    <property name="height-request">146</property>
                    <property name="visible">1</property>
                  <layout><property name="column">1</property><property name="row">1</property></layout></object>
                  </child>
                <child>
                  <object class="GtkToggleButton" id="tbBorderLeft">
                    <property name="width-request">25</property>
                    <property name="height-request">25</property>
                    <property name="visible">1</property>
                    <property name="valign">center</property>
                  <layout><property name="column">0</property><property name="row">1</property></layout></object>
                  </child>
                <child>
                  <object class="GtkToggleButton" id="tbBorderBottom">
                    <property name="width-request">25</property>
                    <property name="height-request">25</property>
                    <property name="visible">1</property>
                    <property name="halign">center</property>
                  <layout><property name="column">1</property><property name="row">2</property></layout></object>
                  </child>
                <child>
                  <object class="GtkToggleButton" id="tbBorderRight">
                    <property name="width-request">25</property>
                    <property name="height-request">25</property>
                    <property name="visible">1</property>
                    <property name="valign">center</property>
                  <layout><property name="column">2</property><property name="row">1</property></layout></object>
                  </child>
              <layout><property name="column">2</property><property name="row">1</property><property name="row-span">7</property></layout></object>
              </child>
          </object>
          </child>
              <child>
          <object class="GtkBox" id="aaDialog">
                    <property name="halign">end</property>
                    <property name="spacing">6</property>
                    <property name="margin-top">6</property>
                      <property name="visible">1</property>
                      <child>
                        <object class="GtkButton" id="btClose">
                          <property name="label">_Close</property>
                          <property name="visible">1</property>
                          <property name="can-focus">1</property>
                        </object>
                        </child>
                      <child>
                        <object class="GtkButton" id="btApply">
                          <property name="label">_Apply</property>
                          <property name="visible">1</property>
                          <property name="can-focus">1</property>
                          </object>
                        </child>
                    </object>
        </child>
</object>
    </child><action-widgets>
      <action-widget response="-7">btClose</action-widget>
      <action-widget response="-10">btApply</action-widget>
    </action-widgets>
  </object>
</interface>