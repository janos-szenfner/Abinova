<?xml version='1.0' encoding='UTF-8'?>
<interface>
  <requires lib="gtk+" version="3.20" />
  <object class="GtkDialog" id="ap_UnixDialog_Field">
    <property name="height-request">351</property>
    <property name="title" translatable="yes">Insert Field</property>
    <property name="modal">1</property>
    
        <child><object class="GtkBox" id="vbxDialog">
          <property name="margin-start">12</property>
          <property name="margin-end">12</property>
          <property name="margin-top">12</property>
          <property name="margin-bottom">12</property>
        <property name="visible">1</property>
        <property name="orientation">vertical</property>
        <property name="spacing">2</property>
        <child>
          <object class="GtkGrid" id="grContent">
            <property name="visible">1</property>
            <property name="vexpand">1</property>
            <property name="row-spacing">6</property>
            <property name="column-spacing">12</property>
            <child>
              <object class="GtkLabel" id="lbTypes">
                <property name="visible">1</property>
                <property name="label" translatable="yes">&lt;b&gt;%s&lt;/b&gt;</property>
                <property name="use-markup">1</property>
                <property name="xalign">0</property>
              <layout><property name="column">0</property><property name="row">0</property></layout></object>
              </child>
            <child>
              <object class="GtkLabel" id="lbFields">
                <property name="visible">1</property>
                <property name="label" translatable="yes">&lt;b&gt;%s&lt;/b&gt;</property>
                <property name="use-markup">1</property>
                <property name="xalign">0</property>
                <property name="yalign">1</property>
              <layout><property name="column">1</property><property name="row">0</property></layout></object>
              </child>
            <child>
              <object class="GtkScrolledWindow" id="swTypes">
                <property name="visible">1</property>
                <property name="can-focus">1</property>
                <property name="margin-start">18</property>
                <property name="vexpand">1</property>
                <property name="hscrollbar-policy">never</property>
                <child>
                  <object class="GtkTreeView" id="tvTypes">
                    <property name="width-request">180</property>
                    <property name="visible">1</property>
                    <property name="can-focus">1</property>
                    <property name="headers-visible">0</property>
                    <child internal-child="selection">
                      <object class="GtkTreeSelection" id="treeview-selection1" />
                    </child>
                  </object>
                </child>
              <layout><property name="column">0</property><property name="row">1</property><property name="row-span">3</property></layout></object>
              </child>
            <child>
              <object class="GtkTreeView" id="tvFields">
                <property name="width-request">180</property>
                <property name="visible">1</property>
                <property name="can-focus">1</property>
                <property name="margin-start">18</property>
                <property name="vexpand">1</property>
                <property name="headers-visible">0</property>
                <child internal-child="selection">
                  <object class="GtkTreeSelection" id="treeview-selection2" />
                </child>
              <layout><property name="column">1</property><property name="row">1</property></layout></object>
              </child>
            <child>
              <object class="GtkLabel" id="lbExtraParameters">
                <property name="visible">1</property>
                <property name="label" translatable="yes">&lt;b&gt;%s&lt;/b&gt;</property>
                <property name="use-markup">1</property>
                <property name="xalign">0</property>
              <layout><property name="column">1</property><property name="row">2</property></layout></object>
              </child>
            <child>
              <object class="GtkEntry" id="edExtraParameters">
                <property name="visible">1</property>
                <property name="can-focus">1</property>
                <property name="margin-start">18</property>
              <layout><property name="column">1</property><property name="row">3</property></layout></object>
              </child>
          </object>
          </child>
              <child>
          <object class="GtkBox" id="aaDialog">
                    <property name="halign">end</property>
                    <property name="spacing">6</property>
                    <property name="margin-top">6</property>
                      <property name="visible">1</property>
                      <child>
                        <object class="GtkButton" id="btCancel">
                          <property name="label">_Cancel</property>
                          <property name="use-underline">1</property>
                          <property name="visible">1</property>
                          <property name="can-focus">1</property>
                        </object>
                      </child>
                      <child>
                        <object class="GtkButton" id="btInsert">
                          <property name="label" translatable="yes">_Insert</property>
                          <property name="visible">1</property>
                          <property name="can-focus">1</property>
                          <property name="use-underline">1</property>
                        </object>
                        </child>
                    </object>
        </child>
</object>
    </child><action-widgets>
      <action-widget response="-6">btCancel</action-widget>
      <action-widget response="1">btInsert</action-widget>
    </action-widgets>
  </object>
</interface>