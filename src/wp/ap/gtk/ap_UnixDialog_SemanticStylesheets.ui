<?xml version='1.0' encoding='UTF-8'?>
<interface>
  <requires lib="gtk+" version="3.20" />
  <object class="GtkDialog" id="window">
    <property name="resizable">0</property>
    
        <child><object class="GtkBox" id="dialog-vbox1">
          <property name="margin-start">12</property>
          <property name="margin-end">12</property>
          <property name="margin-top">12</property>
          <property name="margin-bottom">12</property>
        <property name="orientation">vertical</property>
        <property name="spacing">2</property>
        <child>
          <object class="GtkBox" id="box1">
            <property name="visible">1</property>
            <property name="orientation">vertical</property>
            <child>
              <object class="GtkLabel" id="lbExplanation">
                <property name="visible">1</property>
                <property name="margin-top">2</property>
                <property name="margin-bottom">2</property>
                <property name="wrap">1</property>
              </object>
            </child>
            <child>
              <object class="GtkGrid" id="grid1">
                <property name="visible">1</property>
                <child>
                  <object class="GtkLabel" id="lbContacts">
                    <property name="visible">1</property>
                    <property name="margin-start">5</property>
                    <property name="margin-end">5</property>
                    <property name="label" translatable="yes">Contacts</property>
                    <property name="xalign">0</property>
                  <layout><property name="column">0</property><property name="row">0</property></layout></object>
                  </child>
                <child>
                  <object class="GtkLabel" id="lbEvents">
                    <property name="visible">1</property>
                    <property name="margin-start">5</property>
                    <property name="margin-end">5</property>
                    <property name="label" translatable="yes">Events</property>
                    <property name="xalign">0</property>
                  <layout><property name="column">0</property><property name="row">1</property></layout></object>
                  </child>
                <child>
                  <object class="GtkLabel" id="lbLocations">
                    <property name="visible">1</property>
                    <property name="margin-start">5</property>
                    <property name="margin-end">5</property>
                    <property name="label" translatable="yes">Locations</property>
                    <property name="xalign">0</property>
                  <layout><property name="column">0</property><property name="row">2</property></layout></object>
                  </child>
                <child>
                  <object class="GtkLabel" id="label5">
                    <property name="visible">1</property>
                  <layout><property name="column">0</property><property name="row">3</property></layout></object>
                  </child>
                <child>
                  <object class="GtkLabel" id="label6">
                    <property name="visible">1</property>
                  <layout><property name="column">1</property><property name="row">3</property></layout></object>
                  </child>
                <child>
                  <object class="GtkButton" id="setContacts">
                    <property name="label" translatable="yes">Set For All Existing</property>
                    <property name="visible">1</property>
                    <property name="can-focus">1</property>
                    <property name="receives-default">1</property>
                  <layout><property name="column">2</property><property name="row">0</property></layout></object>
                  </child>
                <child>
                  <object class="GtkButton" id="setEvents">
                    <property name="label" translatable="yes">Set For All Existing</property>
                    <property name="visible">1</property>
                    <property name="can-focus">1</property>
                    <property name="receives-default">1</property>
                  <layout><property name="column">2</property><property name="row">1</property></layout></object>
                  </child>
                <child>
                  <object class="GtkButton" id="setLocations">
                    <property name="label" translatable="yes">Set For All Existing</property>
                    <property name="visible">1</property>
                    <property name="can-focus">1</property>
                    <property name="receives-default">1</property>
                  <layout><property name="column">2</property><property name="row">2</property></layout></object>
                  </child>
                <child>
                  <object class="GtkButton" id="setAll">
                    <property name="label" translatable="yes">Set For All Existing</property>
                    <property name="visible">1</property>
                    <property name="can-focus">1</property>
                    <property name="receives-default">1</property>
                  <layout><property name="column">2</property><property name="row">3</property></layout></object>
                  </child>
                <child>
                  <object class="GtkComboBoxText" id="locations">
                    <property name="visible">1</property>
                  <layout><property name="column">1</property><property name="row">2</property></layout></object>
                  </child>
                <child>
                  <object class="GtkComboBoxText" id="events">
                    <property name="visible">1</property>
                  <layout><property name="column">1</property><property name="row">1</property></layout></object>
                  </child>
                <child>
                  <object class="GtkComboBoxText" id="contacts">
                    <property name="visible">1</property>
                    <property name="hexpand">1</property>
                  <layout><property name="column">1</property><property name="row">0</property></layout></object>
                  </child>
              </object>
              </child>
          </object>
          </child>
              <child>
          <object class="GtkBox" id="dialog-action_area1">
                    <property name="halign">end</property>
                    <property name="spacing">6</property>
                    <property name="margin-top">6</property>
                      <child>
                        <object class="GtkLabel" id="label7">
                          <property name="visible">1</property>
                        </object>
                      </child>
                      <child>
                        <object class="GtkButton" id="OK">
                          <property name="label" translatable="yes">OK</property>
                          <property name="visible">1</property>
                          <property name="can-focus">1</property>
                          <property name="receives-default">1</property>
                        </object>
                        </child>
                    </object>
        </child>
</object>
    </child><action-widgets>
      <action-widget response="0">OK</action-widget>
    </action-widgets>
  </object>
</interface>