                    <property name="can-focus">1</property>
                  </object>
                  </child>
                <child>
                  <object class="GtkLabel" id="lblInnerQuoteStyle">
                    <property name="visible">1</property>
                    <property name="label" translatable="yes">&lt;b&gt;%s&lt;/b&gt;</property>
                    <property name="use-markup">1</property>
                    <property name="xalign">0</property>
                  </object>
                  </child>
                <child>
                  <object class="GtkComboBox" id="omInnerQuoteStyle">
                    <property name="visible">1</property>
                    <property name="can-focus">1</property>
                  </object>
                  </child>
              </object>
              </child>
            <child type="tab">
              <object class="GtkLabel" id="lblSmartQuotes">
                <property name="visible">1</property>
                <property name="label" translatable="yes">Smart Quotes</property>
              </object>
              </child>
          </object>
          </child>
              <child>
          <object class="GtkBox" id="hbbox1">
                    <property name="halign">end</property>
                    <property name="spacing">6</property>
                    <property name="margin-top">6</property>
                      <property name="visible">1</property>
                      <child>
                        <object class="GtkButton" id="btnDefaults">
                          <property name="label">_Revert</property>
                          <property name="use-underline">1</property>
                          <property name="visible">1</property>
                          <property name="can-focus">1</property>
                        </object>
                        </child>
                      <child>
                        <object class="GtkButton" id="btnClose">
                          <property name="label">_Close</property>
                          <property name="use-underline">1</property>
                          <property name="visible">1</property>
                          <property name="can-focus">1</property>
                        </object>
                        </child>
                    </object>
        </child>
</object>
    </child><action-widgets>
      <action-widget response="0">btnDefaults</action-widget>
      <action-widget response="-7">btnClose</action-widget>
    </action-widgets>
  </object>
</interface>