<?xml version='1.0' encoding='UTF-8'?>
<interface>
  <requires lib="gtk+" version="3.20" />
  <object class="GtkAdjustment" id="adjustment1">
    <property name="lower">1</property>
    <property name="upper">120</property>
    <property name="value">1</property>
    <property name="step-increment">1</property>
    <property name="page-increment">1</property>
  </object>
  <object class="GtkDialog" id="ap_UnixDialog_Options">
    <property name="title" translatable="yes">Preferences</property>
    <property name="resizable">0</property>
    <property name="modal">1</property>
    
        <child><object class="GtkBox" id="vbox1">
          <property name="margin-start">12</property>
          <property name="margin-end">12</property>
          <property name="margin-top">12</property>
          <property name="margin-bottom">12</property>
        <property name="visible">1</property>
        <property name="orientation">vertical</property>
        <property name="spacing">2</property>
        <child>
          <object class="GtkNotebook" id="ntbMain">
            <property name="visible">1</property>
            <property name="can-focus">1</property>
            <child>
              <object class="GtkGrid" id="grGeneral">
                <property name="visible">1</property>
                <property name="row-spacing">6</property>
                <property name="column-spacing">12</property>
                <child>
                  <object class="GtkLabel" id="lblUserInterface">
                    <property name="visible">1</property>
                    <property name="label" translatable="yes">&lt;b&gt;%s&lt;/b&gt;</property>
                    <property name="use-markup">1</property>
                    <property name="xalign">0</property>
                  <layout><property name="column">0</property><property name="row">0</property><property name="column-span">2</property></layout></object>
                  </child>
                <child>
                  <object class="GtkLabel" id="lblUnits">
                    <property name="visible">1</property>
                    <property name="margin-start">18</property>
                    <property name="label" translatable="yes">_Units:</property>
                    <property name="use-underline">1</property>
                    <property name="xalign">0</property>
                  <layout><property name="column">0</property><property name="row">1</property></layout></object>
                  </child>
                <child>
                  <object class="GtkComboBox" id="omUnits">
                    <property name="visible">1</property>
                    <property name="can-focus">1</property>
                  <layout><property name="column">1</property><property name="row">1</property></layout></object>
                  </child>
                <child>
                  <object class="GtkButton" id="btnScreenColor">
                    <property name="visible">1</property>
                    <property name="can-focus">1</property>
                    <property name="margin-start">18</property>
                    <child>
                      <object class="GtkBox" id="hbox2">
                        <property name="visible">1</property>
                        <property name="spacing">2</property>
                        <child>
                          <object class="GtkImage" id="image1">
                            <property name="visible">1</property>
                          </object>
                          </child>
                        <child>
                          <object class="GtkLabel" id="lblScreenColor">
                            <property name="visible">1</property>
                            <property name="label" translatable="yes">_Select Screen Color</property>
                            <property name="use-underline">1</property>
                          </object>
                          </child>
                      </object>
                    </child>
                  <layout><property name="column">0</property><property name="row">2</property><property name="column-span">2</property></layout></object>
                  </child>
                <child>
                  <object class="GtkLabel" id="lblApplicationStartup">
                    <property name="visible">1</property>
                    <property name="margin-top">12</property>
                    <property name="label" translatable="yes">&lt;b&gt;%s&lt;/b&gt;</property>
                    <property name="use-markup">1</property>
                    <property name="xalign">0</property>
                  <layout><property name="column">0</property><property name="row">4</property><property name="column-span">2</property></layout></object>
                  </child>
                <child>
                  <object class="GtkCheckButton" id="btnOverwrite">
                    <property name="label" translatable="yes">_Enable overwrite mode</property>
                    <property name="visible">1</property>
                    <property name="can-focus">1</property>
                    <property name="margin-start">18</property>
                    <property name="use-underline">1</property>
                  <layout><property name="column">0</property><property name="row">3</property><property name="column-span">2</property></layout></object>
                  </child>
              </object>
            </child>
            <child type="tab">
              <object class="GtkLabel" id="lblGeneral">
                <property name="visible">1</property>
                <property name="label" translatable="yes">General</property>
              </object>
              </child>
            <child>
              <object class="GtkGrid" id="grDocs">
                <property name="visible">1</property>
                <property name="row-spacing">6</property>
                <property name="column-spacing">12</property>
                <child>
                  <object class="GtkCheckButton" id="chkAutoSave">
                    <property name="label" translatable="yes">&lt;b&gt;%s&lt;/b&gt;</property>
                    <property name="visible">1</property>
                    <property name="can-focus">1</property>
                    <property name="use-underline">1</property>
                  <layout><property name="column">0</property><property name="row">0</property><property name="column-span">3</property></layout></object>
                  </child>
                <child>
                  <object class="GtkLabel" id="lblRTL">
                    <property name="visible">1</property>
                    <property name="margin-top">12</property>
                    <property name="label" translatable="yes">&lt;b&gt;%s&lt;/b&gt;</property>
                    <property name="use-markup">1</property>
                    <property name="xalign">0</property>
                  <layout><property name="column">0</property><property name="row">2</property><property name="column-span">3</property></layout></object>
                  </child>
                <child>
                  <object class="GtkCheckButton" id="chkDefaultToRTL">
                    <property name="label" translatable="yes">_Default to right-to-left text direction</property>
                    <property name="visible">1</property>
                    <property name="can-focus">1</property>
                    <property name="margin-start">18</property>
                    <property name="use-underline">1</property>
                  <layout><property name="column">0</property><property name="row">3</property><property name="column-span">3</property></layout></object>
                  </child>
                <child>
                  <object class="GtkLabel" id="lblSaveFormat">
                    <property name="visible">1</property>
                    <property name="margin-start">18</property>
                    <property name="margin-top">12</property>
                    <property name="label" translatable="yes">_Default file format:</property>
                    <property name="use-underline">1</property>
                    <property name="xalign">0</property>
                  <layout><property name="column">0</property><property name="row">4</property></layout></object>
                  </child>
                <child>
                  <object class="GtkComboBox" id="omSaveFormat">
                    <property name="visible">1</property>
                    <property name="margin-top">12</property>
                    <property name="can-focus">1</property>
                  <layout><property name="column">1</property><property name="row">4</property></layout></object>
                  </child>
                <child>
                  <object class="GtkGrid" id="tblAutoSave">
                    <property name="visible">1</property>
                    <property name="row-spacing">6</property>
                    <property name="column-spacing">12</property>
                    <child>
                      <object class="GtkLabel" id="lblInterval">
                        <property name="visible">1</property>
                        <property name="margin-start">18</property>
                        <property name="label" translatable="yes">_Interval:</property>
                        <property name="use-underline">1</property>
                        <property name="xalign">0</property>
                      <layout><property name="column">0</property><property name="row">0</property></layout></object>
                      </child>
                    <child>
                      <object class="GtkSpinButton" id="spInterval">
                        <property name="width-request">75</property>
                        <property name="visible">1</property>
                        <property name="can-focus">1</property>
                        <property name="adjustment">adjustment1</property>
                        <property name="climb-rate">1</property>
                        <property name="numeric">1</property>
                      <layout><property name="column">1</property><property name="row">0</property></layout></object>
                      </child>
                    <child>
                      <object class="GtkLabel" id="lblMinutes">
                        <property name="visible">1</property>
                        <property name="label" translatable="yes">minute(s)</property>
                        <property name="xalign">0</property>
                      <layout><property name="column">2</property><property name="row">0</property></layout></object>
                      </child>
                    <child>
                      <object class="GtkLabel" id="lblFileExt">
                        <property name="visible">1</property>
                        <property name="margin-start">18</property>
                        <property name="label" translatable="yes">_File extension:</property>
                        <property name="use-underline">1</property>
                        <property name="xalign">0</property>
                      <layout><property name="column">0</property><property name="row">1</property></layout></object>
                      </child>
                    <child>
                      <object class="GtkEntry" id="enFileExt">
                        <property name="width-request">75</property>
                        <property name="visible">1</property>
                        <property name="can-focus">1</property>
                        <property name="text">.bak~</property>
                      <layout><property name="column">1</property><property name="row">1</property></layout></object>
                      </child>
                  <layout><property name="column">0</property><property name="row">1</property><property name="column-span">3</property></layout></object>
                  </child>
              </object>
              </child>
            <child type="tab">
              <object class="GtkLabel" id="lblDocuments">
                <property name="visible">1</property>
                <property name="label" translatable="yes">Documents</property>
              </object>
              </child>
            <child>
              <object class="GtkGrid" id="grSpell">
                <property name="visible">1</property>
                <property name="row-spacing">6</property>
                <child>
                  <object class="GtkCheckButton" id="chkSpellCheckAsType">
                    <property name="label" translatable="yes">Check spelling as you type</property>
                    <property name="visible">1</property>
                    <property name="can-focus">1</property>
                    <property name="margin-start">18</property>
                    <property name="use-underline">1</property>
                  <layout><property name="column">0</property><property name="row">1</property></layout></object>
                  </child>
                <child>
                  <object class="GtkCheckButton" id="chkHighlightMisspelledWords">
                    <property name="label" translatable="yes">Highlight misspelled words</property>
                    <property name="visible">1</property>
                    <property name="can-focus">1</property>
                    <property name="margin-start">18</property>
                    <property name="use-underline">1</property>
                  <layout><property name="column">0</property><property name="row">2</property></layout></object>
                  </child>
                <child>
                  <object class="GtkLabel" id="lblIgnoreWords">
                    <property name="visible">1</property>
                    <property name="margin-top">12</property>
                    <property name="label" translatable="yes">&lt;b&gt;%s&lt;/b&gt;</property>
                    <property name="use-markup">1</property>
                    <property name="xalign">0</property>
                  <layout><property name="column">0</property><property name="row">3</property></layout></object>
                  </child>
                <child>
                  <object class="GtkCheckButton" id="chkIgnoreUppercase">
                    <property name="label" translatable="yes">Ignore _UPPERCASE words</property>
                    <property name="visible">1</property>
                    <property name="can-focus">1</property>
                    <property name="margin-start">18</property>
                    <property name="use-underline">1</property>
                  <layout><property name="column">0</property><property name="row">4</property></layout></object>
                  </child>
                <child>
                  <object class="GtkCheckButton" id="chkIgnoreNumbers">
                    <property name="label" translatable="yes">Ignore words containing _numbers</property>
                    <property name="visible">1</property>
                    <property name="can-focus">1</property>
                    <property name="margin-start">18</property>
                    <property name="use-underline">1</property>
                  <layout><property name="column">0</property><property name="row">5</property></layout></object>
                  </child>
                <child>
                  <object class="GtkLabel" id="lblDictionaries">
                    <property name="visible">1</property>
                    <property name="margin-top">12</property>
                    <property name="label" translatable="yes">&lt;b&gt;%s&lt;/b&gt;</property>
                    <property name="use-markup">1</property>
                    <property name="xalign">0</property>
                  <layout><property name="column">0</property><property name="row">6</property></layout></object>
                  </child>
                <child>
                  <object class="GtkCheckButton" id="chkAlwaysSuggest">
                    <property name="label" translatable="yes">_Always suggest corrections</property>
                    <property name="visible">1</property>
                    <property name="can-focus">1</property>
                    <property name="margin-start">18</property>
                    <property name="use-underline">1</property>
                  <layout><property name="column">0</property><property name="row">7</property></layout></object>
                  </child>
                <child>
                  <object class="GtkCheckButton" id="chkOnlySuggestFromMain">
                    <property name="label" translatable="yes">_Only suggest from main dictionary</property>
                    <property name="visible">1</property>
                    <property name="can-focus">1</property>
                    <property name="margin-start">18</property>
                    <property name="use-underline">1</property>
                  <layout><property name="column">0</property><property name="row">8</property></layout></object>
                  </child>
                <child>
                  <object class="GtkLabel" id="lblGrammar">
                    <property name="visible">1</property>
                    <property name="margin-top">12</property>
                    <property name="label" translatable="yes">&lt;b&gt;%s&lt;/b&gt;</property>
                    <property name="use-markup">1</property>
                    <property name="xalign">0</property>
                  <layout><property name="column">0</property><property name="row">9</property></layout></object>
                  </child>
                <child>
                  <object class="GtkCheckButton" id="chkGrammarCheck">
                    <property name="label" translatable="yes">_Check grammar as you type</property>
                    <property name="visible">1</property>
                    <property name="can-focus">1</property>
                    <property name="margin-start">18</property>
                    <property name="use-underline">1</property>
                  <layout><property name="column">0</property><property name="row">10</property></layout></object>
                  </child>
                <child>
                  <object class="GtkLabel" id="lblSpellCheckingGeneral">
                    <property name="visible">1</property>
                    <property name="label" translatable="yes">&lt;b&gt;%s&lt;/b&gt;</property>
                    <property name="use-markup">1</property>
                    <property name="xalign">0</property>
                  <layout><property name="column">0</property><property name="row">0</property></layout></object>
                  </child>
              </object>
              </child>
            <child type="tab">
              <object class="GtkLabel" id="lblSpellChecking">
                <property name="visible">1</property>
                <property name="label" translatable="yes">Spell Checking</property>
              </object>
              </child>
            <child>
              <object class="GtkBox" id="vbox4">
                <property name="visible">1</property>
                <property name="orientation">vertical</property>
                <property name="spacing">10</property>
                <child>
                  <object class="GtkCheckButton" id="chkSmartQuotes">
                    <property name="label" translatable="yes">Enable smart quotes</property>
                    <property name="visible">1</property>
                    <property name="can-focus">1</property>
                    <property name="use-underline">1</property>
                  </object>
                  </child>
                <child>
                  <object class="GtkCheckButton" id="chkCustomQuoteStyle">
