                                    </child>
                                  </object>
                                </child>
                                <layout><property name="column">0</property><property name="row">3</property><property name="column-span">2</property></layout>
                              </object>
                            </child>
                          </object>
                        </property>
                      </object>
                    </child>
                    <child>
