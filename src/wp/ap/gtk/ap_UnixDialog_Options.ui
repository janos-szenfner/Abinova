<?xml version='1.0' encoding='UTF-8'?>
<interface>
  <requires lib="gtk" version="4.0" />
  <object class="GtkAdjustment" id="adjustment1">
    <property name="lower">1</property>
    <property name="upper">120</property>
    <property name="value">1</property>
    <property name="step-increment">1</property>
    <property name="page-increment">1</property>
  </object>
  <object class="GtkDialog" id="ap_UnixDialog_Options">
    <property name="title" translatable="yes">Preferences</property>
    <property name="modal">1</property>
    <property name="default-width">560</property>
    <property name="default-height">420</property>
    <child>
      <object class="GtkBox" id="vbox1">
        <property name="margin-start">12</property>
        <property name="margin-end">12</property>
        <property name="margin-top">12</property>
        <property name="margin-bottom">12</property>
        <property name="visible">1</property>
        <property name="orientation">vertical</property>
        <property name="spacing">6</property>
        <child>
          <object class="GtkBox" id="hbMain">
            <property name="visible">1</property>
            <property name="orientation">horizontal</property>
            <property name="vexpand">1</property>
            <property name="spacing">6</property>
            <child>
              <object class="GtkScrolledWindow" id="scSidebar">
                <property name="visible">1</property>
                <property name="hscrollbar-policy">never</property>
                <property name="propagate-natural-width">1</property>
                <child>
                  <object class="GtkStackSidebar" id="stbPages">
                    <property name="visible">1</property>
                    <property name="stack">stkMain</property>
                  </object>
                </child>
              </object>
            </child>
            <child>
              <object class="GtkSeparator" id="sepMain">
                <property name="visible">1</property>
                <property name="orientation">vertical</property>
              </object>
            </child>
            <child>
              <object class="GtkScrolledWindow" id="scStack">
                <property name="visible">1</property>
                <property name="hexpand">1</property>
                <property name="hscrollbar-policy">never</property>
                <property name="propagate-natural-height">1</property>
                <child>
                  <object class="GtkStack" id="stkMain">
                    <property name="visible">1</property>
                    <property name="hexpand">1</property>
                    <property name="vexpand">1</property>
                    <property name="margin-start">12</property>
                    <property name="margin-top">6</property>
                    <property name="margin-bottom">6</property>
                    <child>
                      <object class="GtkStackPage" id="pageInterface">
                        <property name="name">interface</property>
                        <property name="title" translatable="yes">Interface</property>
                        <property name="child">
                          <object class="GtkGrid" id="grInterface">
                            <property name="visible">1</property>
                            <property name="valign">start</property>
                            <property name="row-spacing">6</property>
                            <property name="column-spacing">12</property>
                            <child>
                              <object class="GtkLabel" id="lblUserInterface">
                                <property name="visible">1</property>
                                <property name="label" translatable="yes">&lt;b&gt;%s&lt;/b&gt;</property>
                                <property name="use-markup">1</property>
                                <property name="xalign">0</property>
                                <layout><property name="column">0</property><property name="row">0</property><property name="column-span">2</property></layout>
                              </object>
                            </child>
                            <child>
                              <object class="GtkLabel" id="lblUnits">
                                <property name="visible">1</property>
                                <property name="margin-start">18</property>
                                <property name="label" translatable="yes">_Units:</property>
                                <property name="use-underline">1</property>
                                <property name="xalign">0</property>
                                <layout><property name="column">0</property><property name="row">1</property></layout>
                              </object>
                            </child>
                            <child>
                              <object class="GtkDropDown" id="omUnits">
                                <property name="visible">1</property>
                                <property name="can-focus">1</property>
                                <layout><property name="column">1</property><property name="row">1</property></layout>
                              </object>
                            </child>
                            <child>
                              <object class="GtkLabel" id="lblOverwrite">
                                <property name="visible">1</property>
                                <property name="margin-start">18</property>
                                <property name="label" translatable="yes">_Enable overwrite mode</property>
                                <property name="use-underline">1</property>
                                <property name="xalign">0</property>
                                <layout><property name="column">0</property><property name="row">2</property></layout>
                              </object>
                            </child>
                            <child>
                              <object class="GtkSwitch" id="swOverwrite">
                                <property name="visible">1</property>
                                <property name="can-focus">1</property>
                                <property name="valign">center</property>
                                <layout><property name="column">1</property><property name="row">2</property></layout>
                              </object>
                            </child>
                            <child>
