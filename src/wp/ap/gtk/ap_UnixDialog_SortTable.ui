<?xml version='1.0' encoding='UTF-8'?>
<interface>
  <requires lib="gtk" version="4.0" />
  <object class="GtkAdjustment" id="adjColumn">
    <property name="lower">1</property>
    <property name="upper">64</property>
    <property name="value">1</property>
    <property name="step-increment">1</property>
    <property name="page-increment">5</property>
  </object>
  <object class="GtkDialog" id="ap_UnixDialog_SortTable">
    <property name="title" translatable="yes">Sort</property>
    <property name="resizable">0</property>
    <property name="modal">1</property>
        <child><object class="GtkBox" id="vbDialog">
          <property name="margin-start">12</property>
          <property name="margin-end">12</property>
          <property name="margin-top">12</property>
          <property name="margin-bottom">12</property>
        <property name="visible">1</property>
        <property name="orientation">vertical</property>
        <property name="spacing">6</property>
        <child>
          <object class="GtkGrid" id="grContent">
            <property name="visible">1</property>
            <property name="row-spacing">6</property>
            <property name="column-spacing">12</property>
            <child>
              <object class="GtkLabel" id="lbColumn">
                <property name="visible">1</property>
                <property name="label" translatable="yes">Sort by column:</property>
                <property name="xalign">0</property>
              <layout><property name="column">0</property><property name="row">0</property></layout></object>
              </child>
            <child>
              <object class="GtkSpinButton" id="sbColumn">
                <property name="width-request">64</property>
                <property name="visible">1</property>
                <property name="can-focus">1</property>
                <property name="adjustment">adjColumn</property>
                <property name="climb-rate">1</property>
                <property name="numeric">1</property>
              <layout><property name="column">1</property><property name="row">0</property></layout></object>
              </child>
            <child>
              <object class="GtkLabel" id="lbType">
                <property name="visible">1</property>
                <property name="label" translatable="yes">&lt;b&gt;%s&lt;/b&gt;</property>
                <property name="use-markup">1</property>
                <property name="xalign">0</property>
                <property name="margin-top">6</property>
              <layout><property name="column">0</property><property name="row">1</property><property name="column-span">2</property></layout></object>
              </child>
            <child>
              <object class="GtkCheckButton" id="rbTypeText">
                <property name="label" translatable="yes">_Text</property>
                <property name="visible">1</property>
                <property name="can-focus">1</property>
                <property name="margin-start">18</property>
                <property name="use-underline">1</property>
                <property name="active">1</property>
              <layout><property name="column">0</property><property name="row">2</property><property name="column-span">2</property></layout></object>
              </child>
            <child>
              <object class="GtkCheckButton" id="rbTypeNumber">
                <property name="label" translatable="yes">_Number</property>
                <property name="visible">1</property>
                <property name="can-focus">1</property>
                <property name="margin-start">18</property>
                <property name="use-underline">1</property>
                <property name="group">rbTypeText</property>
              <layout><property name="column">0</property><property name="row">3</property><property name="column-span">2</property></layout></object>
              </child>
            <child>
              <object class="GtkCheckButton" id="rbTypeDate">
                <property name="label" translatable="yes">_Date</property>
                <property name="visible">1</property>
                <property name="can-focus">1</property>
                <property name="margin-start">18</property>
                <property name="use-underline">1</property>
                <property name="group">rbTypeText</property>
              <layout><property name="column">0</property><property name="row">4</property><property name="column-span">2</property></layout></object>
              </child>
            <child>
              <object class="GtkLabel" id="lbOrder">
                <property name="visible">1</property>
                <property name="label" translatable="yes">&lt;b&gt;%s&lt;/b&gt;</property>
                <property name="use-markup">1</property>
                <property name="xalign">0</property>
                <property name="margin-top">6</property>
              <layout><property name="column">0</property><property name="row">5</property><property name="column-span">2</property></layout></object>
              </child>
            <child>
              <object class="GtkCheckButton" id="rbAsc">
                <property name="label" translatable="yes">_Ascending</property>
                <property name="visible">1</property>
                <property name="can-focus">1</property>
                <property name="margin-start">18</property>
                <property name="use-underline">1</property>
                <property name="active">1</property>
              <layout><property name="column">0</property><property name="row">6</property><property name="column-span">2</property></layout></object>
              </child>
            <child>
              <object class="GtkCheckButton" id="rbDesc">
                <property name="label" translatable="yes">_Descending</property>
                <property name="visible">1</property>
                <property name="can-focus">1</property>
                <property name="margin-start">18</property>
                <property name="use-underline">1</property>
                <property name="group">rbAsc</property>
              <layout><property name="column">0</property><property name="row">7</property><property name="column-span">2</property></layout></object>
              </child>
            <child>
              <object class="GtkCheckButton" id="cbHeader">
                <property name="label" translatable="yes">_Header row</property>
                <property name="visible">1</property>
                <property name="can-focus">1</property>
                <property name="margin-start">18</property>
                <property name="margin-top">8</property>
                <property name="use-underline">1</property>
              <layout><property name="column">0</property><property name="row">8</property><property name="column-span">2</property></layout></object>
              </child>
          </object>
          </child>
              <child>
          <object class="GtkBox" id="aaDialog">
                    <property name="halign">end</property>
                    <property name="spacing">6</property>
                    <property name="margin-top">6</property>
                      <property name="visible">1</property>
                      <child>
                        <object class="GtkButton" id="btCancel">
                          <property name="label">_Cancel</property>
                          <property name="use-underline">1</property>
                          <property name="visible">1</property>
                          <property name="can-focus">1</property>
                        </object>
                        </child>
                      <child>
                        <object class="GtkButton" id="btSort">
                          <property name="label" translatable="yes">_Sort</property>
                          <property name="visible">1</property>
                          <property name="can-focus">1</property>
                          <property name="use-underline">1</property>
                        </object>
                        </child>
                    </object>
        </child>
</object>
    </child><action-widgets>
      <action-widget response="-6">btCancel</action-widget>
      <action-widget response="1">btSort</action-widget>
    </action-widgets>
  </object>
</interface>
