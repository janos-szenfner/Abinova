<?xml version='1.0' encoding='UTF-8'?>
<interface>
  <requires lib="gtk+" version="3.20" />
  <object class="GtkDialog" id="ap_UnixDialog_MetaData">
    <property name="title" translatable="yes">Document Properties</property>
    <property name="modal">1</property>
    
        <child><object class="GtkBox" id="vbxDialog">
          <property name="margin-start">12</property>
          <property name="margin-end">12</property>
          <property name="margin-top">12</property>
          <property name="margin-bottom">12</property>
        <property name="visible">1</property>
        <property name="orientation">vertical</property>
        <property name="spacing">2</property>
        <child>
          <object class="GtkNotebook" id="nbProperties">
            <property name="visible">1</property>
            <property name="can-focus">1</property>
            <child>
              <object class="GtkGrid" id="grGeneral">
                <property name="visible">1</property>
                <property name="row-spacing">6</property>
                <property name="column-spacing">12</property>
                <child>
                  <object class="GtkLabel" id="lbTitle">
                    <property name="visible">1</property>
                    <property name="label" translatable="yes">Title:</property>
                    <property name="xalign">0</property>
                  <layout><property name="column">0</property><property name="row">0</property></layout></object>
                  </child>
                <child>
                  <object class="GtkLabel" id="lbSubject">
                    <property name="visible">1</property>
                    <property name="label" translatable="yes">Subject:</property>
                    <property name="xalign">0</property>
                  <layout><property name="column">0</property><property name="row">1</property></layout></object>
                  </child>
                <child>
                  <object class="GtkEntry" id="enTitle">
                    <property name="visible">1</property>
                    <property name="can-focus">1</property>
                    <property name="hexpand">1</property>
                  <layout><property name="column">1</property><property name="row">0</property></layout></object>
                  </child>
                <child>
                  <object class="GtkEntry" id="enSubject">
                    <property name="visible">1</property>
                    <property name="can-focus">1</property>
                  <layout><property name="column">1</property><property name="row">1</property></layout></object>
                  </child>
                <child>
                  <object class="GtkLabel" id="lbAuthor">
                    <property name="visible">1</property>
                    <property name="label" translatable="yes">Author:</property>
                    <property name="xalign">0</property>
                  <layout><property name="column">0</property><property name="row">2</property></layout></object>
                  </child>
                <child>
                  <object class="GtkLabel" id="lbPublisher">
                    <property name="visible">1</property>
                    <property name="label" translatable="yes">Publisher:</property>
                    <property name="xalign">0</property>
                  <layout><property name="column">0</property><property name="row">3</property></layout></object>
                  </child>
                <child>
                  <object class="GtkLabel" id="lbContributors">
                    <property name="visible">1</property>
                    <property name="label" translatable="yes">Contributor(s):</property>
                    <property name="xalign">0</property>
                  <layout><property name="column">0</property><property name="row">4</property></layout></object>
                  </child>
                <child>
                  <object class="GtkEntry" id="enAuthor">
                    <property name="visible">1</property>
                    <property name="can-focus">1</property>
                  <layout><property name="column">1</property><property name="row">2</property></layout></object>
                  </child>
                <child>
                  <object class="GtkEntry" id="enPublisher">
                    <property name="visible">1</property>
                    <property name="can-focus">1</property>
                  <layout><property name="column">1</property><property name="row">3</property></layout></object>
                  </child>
                <child>
                  <object class="GtkEntry" id="enContributors">
                    <property name="visible">1</property>
                    <property name="can-focus">1</property>
                  <layout><property name="column">1</property><property name="row">4</property></layout></object>
                  </child>
              </object>
            </child>
            <child type="tab">
              <object class="GtkLabel" id="lbGeneral_Tab">
                <property name="visible">1</property>
                <property name="label" translatable="yes">General</property>
              </object>
              </child>
            <child>
              <object class="GtkGrid" id="grSummary">
                <property name="visible">1</property>
                <property name="row-spacing">6</property>
                <property name="column-spacing">12</property>
                <child>
                  <object class="GtkEntry" id="enCategory">
                    <property name="visible">1</property>
                    <property name="can-focus">1</property>
                  <layout><property name="column">1</property><property name="row">0</property></layout></object>
                  </child>
                <child>
                  <object class="GtkLabel" id="lbCategory">
                    <property name="visible">1</property>
                    <property name="label" translatable="yes">Category:</property>
                    <property name="xalign">0</property>
                  <layout><property name="column">0</property><property name="row">0</property></layout></object>
                  </child>
                <child>
                  <object class="GtkLabel" id="lbKeywords">
                    <property name="visible">1</property>
                    <property name="label" translatable="yes">Keywords:</property>
                    <property name="xalign">0</property>
                  <layout><property name="column">0</property><property name="row">1</property></layout></object>
                  </child>
                <child>
                  <object class="GtkEntry" id="enKeywords">
                    <property name="visible">1</property>
                    <property name="can-focus">1</property>
                  <layout><property name="column">1</property><property name="row">1</property></layout></object>
                  </child>
                <child>
                  <object class="GtkLabel" id="lbLanguages">
                    <property name="visible">1</property>
                    <property name="label" translatable="yes">Language(s):</property>
                    <property name="xalign">0</property>
                  <layout><property name="column">0</property><property name="row">2</property></layout></object>
                  </child>
                <child>
                  <object class="GtkEntry" id="enLanguages">
                    <property name="visible">1</property>
                    <property name="can-focus">1</property>
                  <layout><property name="column">1</property><property name="row">2</property></layout></object>
                  </child>
                <child>
                  <object class="GtkScrolledWindow" id="swDescription">
                    <property name="visible">1</property>
                    <property name="can-focus">1</property>
                    <property name="hexpand">1</property>
                    <property name="vexpand">1</property>
                    <child>
                      <object class="GtkTextView" id="tvDescription">
                        <property name="visible">1</property>
                        <property name="can-focus">1</property>
                        <property name="wrap-mode">word</property>
                      </object>
                    </child>
                  <layout><property name="column">1</property><property name="row">3</property></layout></object>
                  </child>
                <child>
                  <object class="GtkLabel" id="lbDescription">
                    <property name="visible">1</property>
                    <property name="label" translatable="yes">Description:</property>
                    <property name="xalign">0</property>
                    <property name="yalign">0</property>
                  <layout><property name="column">0</property><property name="row">3</property></layout></object>
                  </child>
              </object>
              </child>
            <child type="tab">
              <object class="GtkLabel" id="lbSummary_Tab">
                <property name="visible">1</property>
                <property name="label" translatable="yes">Summary</property>
              </object>
              </child>
            <child>
              <object class="GtkGrid" id="grPermissions">
                <property name="visible">1</property>
                <property name="row-spacing">6</property>
                <property name="column-spacing">12</property>
                <child>
                  <object class="GtkLabel" id="lbSource">
                    <property name="visible">1</property>
                    <property name="label" translatable="yes">Source:</property>
                    <property name="xalign">0</property>
                  <layout><property name="column">0</property><property name="row">0</property></layout></object>
                  </child>
                <child>
                  <object class="GtkLabel" id="lbRelation">
                    <property name="visible">1</property>
                    <property name="label" translatable="yes">Relation:</property>
                    <property name="xalign">0</property>
                  <layout><property name="column">0</property><property name="row">1</property></layout></object>
                  </child>
                <child>
                  <object class="GtkLabel" id="lbCoverage">
                    <property name="visible">1</property>
                    <property name="label" translatable="yes">Coverage:</property>
                    <property name="xalign">0</property>
                  <layout><property name="column">0</property><property name="row">2</property></layout></object>
                  </child>
                <child>
                  <object class="GtkLabel" id="lbRights">
                    <property name="visible">1</property>
                    <property name="label" translatable="yes">Rights:</property>
                    <property name="xalign">0</property>
                  <layout><property name="column">0</property><property name="row">3</property></layout></object>
                  </child>
                <child>
                  <object class="GtkEntry" id="enSource">
                    <property name="visible">1</property>
                    <property name="can-focus">1</property>
                    <property name="hexpand">1</property>
                  <layout><property name="column">1</property><property name="row">0</property></layout></object>
                  </child>
                <child>
                  <object class="GtkEntry" id="enRelation">
                    <property name="visible">1</property>
                    <property name="can-focus">1</property>
                  <layout><property name="column">1</property><property name="row">1</property></layout></object>
                  </child>
                <child>
                  <object class="GtkEntry" id="enCoverage">
                    <property name="visible">1</property>
                    <property name="can-focus">1</property>
                  <layout><property name="column">1</property><property name="row">2</property></layout></object>
                  </child>
                <child>
                  <object class="GtkEntry" id="enRights">
                    <property name="visible">1</property>
                    <property name="can-focus">1</property>
                  <layout><property name="column">1</property><property name="row">3</property></layout></object>
                  </child>
              </object>
              </child>
            <child type="tab">
              <object class="GtkLabel" id="lbPermissions_Tab">
                <property name="visible">1</property>
                <property name="label" translatable="yes">Permissions</property>
              </object>
              </child>
          </object>
          </child>
              <child>
          <object class="GtkBox" id="aaDialog">
                    <property name="halign">end</property>
                    <property name="spacing">6</property>
                    <property name="margin-top">6</property>
                      <property name="visible">1</property>
                      <child>
                        <object class="GtkButton" id="btCancel">
                          <property name="label">_Cancel</property>
                          <property name="visible">1</property>
                          <property name="can-focus">1</property>
                        </object>
                      </child>
                      <child>
                        <object class="GtkButton" id="btOK">
                          <property name="label">_OK</property>
                          <property name="visible">1</property>
                          <property name="can-focus">1</property>
                          </object>
                        </child>
                    </object>
        </child>
</object>
    </child><action-widgets>
      <action-widget response="-6">btCancel</action-widget>
      <action-widget response="-5">btOK</action-widget>
    </action-widgets>
  </object>
</interface>