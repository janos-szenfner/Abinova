<?xml version='1.0' encoding='UTF-8'?>
<interface>
  <requires lib="gtk+" version="3.20" />
  <object class="GtkDialog" id="ap_UnixDialog_New">
    <property name="visible">1</property>
    <property name="title" translatable="yes">dialog1</property>
    <child internal-child="vbox">
      <object class="GtkBox" id="dialog-vbox1">
        <property name="visible">1</property>
        <property name="orientation">vertical</property>
        <property name="spacing">12</property>
        <child internal-child="action_area">
          <object class="GtkBox" id="dialog-action_area1">
            <property name="visible">1</property>
            <child>
              <object class="GtkButton" id="btCancel">
                <property name="label">_Cancel</property>
                <property name="visible">1</property>
                <property name="can-focus">1</property>
                <property name="can-default">1</property>
              </object>
            </child>
            <child>
              <object class="GtkButton" id="btOK">
                <property name="label">_OK</property>
                <property name="visible">1</property>
                <property name="can-focus">1</property>
                <property name="can-default">1</property>
              </object>
              <packing>
                <property name="position">1</property>
              </packing>
            </child>
          </object>
          <packing>
            </packing>
        </child>
        <child>
          <object class="GtkBox" id="hbox1">
            <property name="visible">1</property>
            <child>
              <object class="GtkLabel" id="label2">
                <property name="visible">1</property>
                <property name="margin-start">2</property>
                <property name="margin-end">2</property>
              </object>
              <packing>
                </packing>
            </child>
            <child>
              <object class="GtkBox" id="vbox6">
                <property name="visible">1</property>
                <property name="orientation">vertical</property>
                <property name="spacing">12</property>
                <child>
                  <object class="GtkBox" id="vbox7">
                    <property name="visible">1</property>
                    <property name="orientation">vertical</property>
                    <child>
                      <object class="GtkCheckButton" id="rdTemplate">
                        <property name="label" translatable="yes">Create a new document from a template</property>
                        <property name="visible">1</property>
                        <property name="can-focus">1</property>
                        <property name="use-underline">1</property>
                      </object>
                      <packing>
                        </packing>
                    </child>
                    <child>
                      <object class="GtkBox" id="hbox2">
                        <property name="visible">1</property>
                        <child>
                          <object class="GtkLabel" id="label4">
                            <property name="visible">1</property>
                          </object>
                          <packing>
                            </packing>
                        </child>
                        <child>
                          <object class="GtkScrolledWindow" id="swTemplates">
                            <property name="visible">1</property>
                            <property name="can-focus">1</property>
                            <child>
                              <object class="GtkTreeView" id="tvTemplates">
                                <property name="width-request">160</property>
                                <property name="height-request">160</property>
                                <property name="visible">1</property>
                                <property name="sensitive">0</property>
                                <property name="can-focus">1</property>
                                <property name="headers-visible">0</property>
                                <child internal-child="selection">
                                  <object class="GtkTreeSelection" id="treeview-selection1" />
                                </child>
                              </object>
                            </child>
                          </object>
                          <packing>
                            <property name="hexpand">1</property>
                            <property name="vexpand">1</property>
                            <property name="position">1</property>
                          </packing>
                        </child>
                      </object>
                      <packing>
                        <property name="hexpand">1</property>
                        <property name="vexpand">1</property>
                        <property name="position">1</property>
                      </packing>
                    </child>
                  </object>
                  <packing>
                    <property name="hexpand">1</property>
                    <property name="vexpand">1</property>
                  </packing>
                </child>
                <child>
                  <object class="GtkBox" id="vbox8">
                    <property name="visible">1</property>
                    <property name="orientation">vertical</property>
                    <child>
                      <object class="GtkCheckButton" id="rdOpen">
                        <property name="label" translatable="yes">Open an existing file</property>
                        <property name="visible">1</property>
                        <property name="can-focus">1</property>
                        <property name="use-underline">1</property>
                        <property name="group">rdTemplate</property>
                      </object>
                      <packing>
                        </packing>
                    </child>
                    <child>
                      <object class="GtkBox" id="hbox3">
                        <property name="visible">1</property>
                        <child>
                          <object class="GtkLabel" id="label5">
                            <property name="visible">1</property>
                          </object>
                          <packing>
                            </packing>
                        </child>
                        <child>
                          <object class="GtkButton" id="btFile">
                            <property name="label">_Open</property>
                            <property name="visible">1</property>
                            <property name="sensitive">0</property>
                            <property name="can-focus">1</property>
                          </object>
                          <packing>
                            <property name="hexpand">1</property>
                            <property name="vexpand">1</property>
                            <property name="position">1</property>
                          </packing>
                        </child>
                      </object>
                      <packing>
                        <property name="hexpand">1</property>
                        <property name="vexpand">1</property>
                        <property name="position">1</property>
                      </packing>
                    </child>
                  </object>
                  <packing>
                    <property name="position">1</property>
                  </packing>
                </child>
              </object>
              <packing>
                <property name="hexpand">1</property>
                <property name="vexpand">1</property>
                <property name="position">1</property>
              </packing>
            </child>
            <child>
              <object class="GtkLabel" id="label3">
                <property name="visible">1</property>
                <property name="margin-start">2</property>
                <property name="margin-end">2</property>
              </object>
              <packing>
                <property name="position">2</property>
              </packing>
            </child>
          </object>
          <packing>
            <property name="hexpand">1</property>
            <property name="vexpand">1</property>
            <property name="position">1</property>
          </packing>
        </child>
      </object>
    </child>
    <action-widgets>
      <action-widget response="-6">btCancel</action-widget>
      <action-widget response="-5">btOK</action-widget>
    </action-widgets>
  </object>
</interface>