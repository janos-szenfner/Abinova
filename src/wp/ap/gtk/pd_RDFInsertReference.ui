<?xml version='1.0' encoding='UTF-8'?>
<interface>
  <requires lib="gtk+" version="3.20" />
  <object class="GtkDialog" id="window">
    <property name="title" translatable="yes">abiword: Insert Reference to Semantic Item</property>
    <property name="default-width">375</property>
    <property name="default-height">260</property>
    
        <child><object class="GtkBox" id="dialog-vbox1">
          <property name="margin-start">12</property>
          <property name="margin-end">12</property>
          <property name="margin-top">12</property>
          <property name="margin-bottom">12</property>
        <property name="orientation">vertical</property>
        <property name="spacing">2</property>
        <child>
          <object class="GtkScrolledWindow" id="scrolledwindow1">
            <property name="visible">1</property>
            <property name="can-focus">1</property>
            <property name="hexpand">1</property>
            <property name="vexpand">1</property>
            <child>
              <object class="GtkTreeView" id="tv">
                <property name="visible">1</property>
                <property name="can-focus">1</property>
                <property name="search-column">0</property>
                <child internal-child="selection">
                  <object class="GtkTreeSelection" id="treeview-selection" />
                </child>
              </object>
            </child>
          </object>
          </child>
              <child>
          <object class="GtkBox" id="dialog-action_area1">
                    <property name="halign">end</property>
                    <property name="spacing">6</property>
                    <property name="margin-top">6</property>
                      <child>
                        <object class="GtkButton" id="ok">
                          <property name="label" translatable="yes">Insert Reference</property>
                          <property name="visible">1</property>
                          <property name="can-focus">1</property>
                          <property name="receives-default">1</property>
                        </object>
                      </child>
                    </object>
        </child>
</object>
    </child><action-widgets>
      <action-widget response="0">ok</action-widget>
    </action-widgets>
  </object>
</interface>